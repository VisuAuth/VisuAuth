@namespace VisuAuth.AdminUi.Pages
@addTagHelper *, Microsoft.AspNetCore.Mvc.TagHelpers
@addTagHelper *, VisuAuth.AdminUi
@using Microsoft.AspNetCore.Mvc.Localization
@using Microsoft.Extensions.Localization
@using VisuAuth.AdminUi
@* AdminSharedResources is the marker bound to Resources/AdminSharedResources.{culture}.json.
   Two flavours of localizer are injected on every admin page:
     L  → IHtmlLocalizer for strings whose translation contains HTML
          (<strong>, <code>, links). Razor renders the value raw.
     Ls → IStringLocalizer for plain-text strings (attribute values,
          aria-labels, placeholders). Razor HTML-encodes the value. *@
@inject IHtmlLocalizer<AdminSharedResources> L
@inject IStringLocalizer<AdminSharedResources> Ls
