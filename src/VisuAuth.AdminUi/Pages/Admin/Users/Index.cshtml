@page "/visuauth/admin/users"
@model VisuAuth.AdminUi.Pages.Admin.Users.IndexModel
@{
    ViewData["Title"] = Ls["Users.PageTitle"].Value;
}

<div class="va-page-header">
    <h1>@Ls["Users.Title"] <span class="va-muted" style="font-weight:400;font-size:1rem;">(@Model.Result.Total)</span></h1>
    <div class="va-detail-status">
        <span class="va-muted htmx-indicator" id="va-search-indicator">@Ls["Users.SearchIndicator"]</span>
        <a class="va-btn va-btn-primary va-btn-small" href="/visuauth/admin/users/new">@Ls["Users.NewButton"]</a>
    </div>
</div>

@*  Single htmx-aware form — every input updates the table partial. The
    keyup trigger is scoped to the search box so typing into it stays
    debounced; selects fire on change, so the whole row stays in sync. *@
<form id="va-users-filter"
      hx-get="/visuauth/admin/users"
      hx-target="#va-users-table"
      hx-swap="outerHTML"
      hx-trigger="change, keyup changed delay:300ms from:input.va-search, search from:input.va-search"
      hx-indicator="#va-search-indicator"
      hx-push-url="true"
      class="va-filters">
    <input type="search"
           class="va-search va-input"
           name="q"
           value="@Model.SearchTerm"
           placeholder="@Ls["Users.SearchPlaceholder"]"
           autocomplete="off" />

    @if (Model.AvailableRoles.Count > 0)
    {
        <select name="role" class="va-input va-filter-select" aria-label="@Ls["Users.FilterRoleAria"]">
            <option value="">@Ls["Users.FilterRoleAny"]</option>
            @foreach (var role in Model.AvailableRoles)
            {
                <option value="@role.Name" selected="@(string.Equals(role.Name, Model.RoleFilter, StringComparison.OrdinalIgnoreCase) ? "selected" : null)">@role.Name</option>
            }
        </select>
    }

    <select name="status" class="va-input va-filter-select" aria-label="@Ls["Users.FilterStatusAria"]">
        <option value="">@Ls["Users.FilterStatusAny"]</option>
        <option value="active" selected="@(Model.StatusFilter == "active" ? "selected" : null)">@Ls["Common.StatusActive"]</option>
        <option value="locked" selected="@(Model.StatusFilter == "locked" ? "selected" : null)">@Ls["Common.StatusLocked"]</option>
    </select>

    <select name="verified" class="va-input va-filter-select" aria-label="@Ls["Users.FilterVerifiedAria"]">
        <option value="">@Ls["Users.FilterVerifiedAny"]</option>
        <option value="true" selected="@(Model.VerifiedFilter == "true" ? "selected" : null)">@Ls["Common.Verified"]</option>
        <option value="false" selected="@(Model.VerifiedFilter == "false" ? "selected" : null)">@Ls["Common.Pending"]</option>
    </select>

    <select name="twofa" class="va-input va-filter-select" aria-label="@Ls["Users.Filter2faAria"]">
        <option value="">@Ls["Users.Filter2faAny"]</option>
        <option value="true" selected="@(Model.TwoFactorFilter == "true" ? "selected" : null)">@Ls["Users.Filter2faOn"]</option>
        <option value="false" selected="@(Model.TwoFactorFilter == "false" ? "selected" : null)">@Ls["Users.Filter2faOff"]</option>
    </select>
</form>

<div id="va-users-table">
    <partial name="_UsersTable" model="Model" />
</div>
