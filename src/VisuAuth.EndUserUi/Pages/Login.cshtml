@page "/visuauth/login"
@model VisuAuth.EndUserUi.Pages.LoginModel
@{
    Layout = "_EndUserLayout";
    ViewData["Title"] = Ls["Login.PageTitle"].Value;
}

@if (Model.DeepLinkPreviewUrl is { Length: > 0 } callback)
{
    <h1 class="va-enduser-heading">@Ls["Login.PreviewHeading"]</h1>
    <p class="va-enduser-subtitle">@L["Login.PreviewSubtitle"]</p>

    <div class="va-alert va-alert-info" role="status">
        <p><strong>@Ls["Login.PreviewCallbackLabel"]</strong></p>
        <code class="va-temp-password">@callback</code>
    </div>

    <div class="va-enduser-form">
        <a href="@callback" class="va-btn va-btn-primary">@Ls["Login.PreviewContinue"]</a>
    </div>

    <div class="va-enduser-footer">
        <a href="/">@Ls["Login.PreviewBack"]</a>
    </div>
}
else
{
    <h1 class="va-enduser-heading">@Ls["Login.Heading"]</h1>
    <p class="va-enduser-subtitle">@Ls["Login.Subtitle"]</p>

    @if (Model.ErrorMessage is { Length: > 0 } error)
    {
        <div class="va-alert va-alert-danger" role="alert">@error</div>
    }

    @if (Model.Capabilities.SupportsLocalLogin)
    {
        <form method="post" asp-page="/Login" class="va-enduser-form" autocomplete="on">
            @Html.AntiForgeryToken()
            <input type="hidden" name="returnUrl" value="@Model.ReturnUrl" />

            <label class="va-field">
                <span class="va-field-label">@Ls["Common.LabelEmail"]</span>
                <input type="email"
                       name="Form.Email"
                       value="@Model.Form.Email"
                       class="va-input"
                       autocomplete="username"
                       required
                       autofocus />
            </label>

            <va-password name="Form.Password" autocomplete="current-password" />

            <label class="va-checkbox">
                @{ var rememberChecked = Model.Form.RememberMe ? "checked" : null; }
                <input type="checkbox" name="Form.RememberMe" value="true" checked="@rememberChecked" />
                <span>@Ls["Login.RememberMe"]</span>
            </label>

            <button type="submit" class="va-btn va-btn-primary">@Ls["Login.Submit"]</button>
        </form>

        @* External providers — capability-gated AND auto-suppressed when no
           provider is registered, so consumers who don't wire any get an
           identical layout to today's. The "or" divider only renders when
           there's actually something to choose from. *@
        @if (Model.ExternalProviders.Count > 0)
        {
            <div class="va-divider"><span>@Ls["Login.OrDivider"]</span></div>

            <div class="va-external-providers">
                @foreach (var provider in Model.ExternalProviders)
                {
                    <form method="post"
                          asp-page="/ExternalLogin/Start"
                          class="va-enduser-form"
                          autocomplete="off">
                        @Html.AntiForgeryToken()
                        <input type="hidden" name="scheme" value="@provider.Scheme" />
                        <input type="hidden" name="returnUrl" value="@Model.ReturnUrl" />
                        <button type="submit" class="va-btn va-btn-secondary va-btn-provider">
                            <va-provider-icon scheme="@provider.Scheme" />
                            <span>@string.Format(System.Globalization.CultureInfo.CurrentUICulture, Ls["Login.ContinueWith"].Value, provider.DisplayName)</span>
                        </button>
                    </form>
                }
            </div>
        }

        <div class="va-enduser-footer">
            <a href="/visuauth/forgot-password">@Ls["Login.Forgot"]</a>
            &middot;
            <a href="/visuauth/register">@Ls["Login.Register"]</a>
        </div>
    }
    else if (Model.ExternalProviders.Count > 0)
    {
        @* Backend without local login (e.g. future Entra adapter): still
           offer external providers as the only sign-in path. *@
        <p class="va-enduser-subtitle">@Ls["Login.ExternalOnly"]</p>
        <div class="va-external-providers">
            @foreach (var provider in Model.ExternalProviders)
            {
                <form method="post"
                      asp-page="/ExternalLogin/Start"
                      class="va-enduser-form"
                      autocomplete="off">
                    @Html.AntiForgeryToken()
                    <input type="hidden" name="scheme" value="@provider.Scheme" />
                    <input type="hidden" name="returnUrl" value="@Model.ReturnUrl" />
                    <button type="submit" class="va-btn va-btn-primary va-btn-provider">
                        <va-provider-icon scheme="@provider.Scheme" />
                        <span>@string.Format(System.Globalization.CultureInfo.CurrentUICulture, Ls["Login.ContinueWith"].Value, provider.DisplayName)</span>
                    </button>
                </form>
            }
        </div>
    }
    else
    {
        <p class="va-enduser-subtitle">@Ls["Login.ExternalOnly"]</p>
    }
}
