@page "/visuauth/admin/users/new"
@model VisuAuth.AdminUi.Pages.Admin.Users.NewModel
@{
    ViewData["Title"] = "New user — VisuAuth Admin";
}

<div class="va-page-header">
    <div>
        <a class="va-back" href="/visuauth/admin/users">‹ Back to users</a>
        <h1>New user</h1>
        <div class="va-muted va-detail-subtitle">
            Provision a fresh account in this backend.
        </div>
    </div>
</div>

@if (Model.Errors.Count > 0)
{
    <div class="va-alert va-alert-danger" role="alert">
        <strong>Could not create the user.</strong>
        <ul>
            @foreach (var err in Model.Errors)
            {
                <li>@err</li>
            }
        </ul>
    </div>
}

@if (Model.CreatedUserId is { Length: > 0 } createdId)
{
    <div class="va-alert va-alert-success" role="status">
        <p>
            User created.
            <a href="/visuauth/admin/users/@createdId">Open detail page ›</a>
        </p>
    </div>

    if (Model.GeneratedPassword is { Length: > 0 } temp)
    {
        <div class="va-alert va-alert-info" role="status">
            <p>
                <strong>Temporary password.</strong> Hand it to the user — VisuAuth
                will not show it again.
            </p>
            <partial name="_CopyableSecret" model="@temp" />
        </div>
    }
}

<section class="va-card va-detail-card">
    <div class="va-detail-card-header">
        <h2>Profile</h2>
    </div>

    <form method="post" autocomplete="off">
        <div class="va-form-grid">
            <label class="va-field">
                <span class="va-field-label">Email <span class="va-required">*</span></span>
                <input type="email"
                       name="Form.Email"
                       value="@Model.Form.Email"
                       required
                       class="va-input" />
            </label>

            <label class="va-field">
                <span class="va-field-label">Username</span>
                <input type="text"
                       name="Form.UserName"
                       value="@Model.Form.UserName"
                       placeholder="Defaults to the email when blank"
                       class="va-input" />
            </label>

            <label class="va-field">
                <span class="va-field-label">Password</span>
                <div class="va-password-wrap">
                    <input type="password"
                           name="Form.Password"
                           value=""
                           placeholder="Leave blank to autogenerate a temporary one"
                           class="va-input"
                           autocomplete="new-password" />
                    <button type="button"
                            class="va-password-toggle"
                            data-va-password-toggle
                            aria-label="Show password"
                            aria-pressed="false">
                        <svg class="va-icon-eye" viewBox="0 0 24 24" aria-hidden="true">
                            <path d="M1 12s4-8 11-8 11 8 11 8-4 8-11 8-11-8-11-8z" />
                            <circle cx="12" cy="12" r="3" />
                        </svg>
                        <svg class="va-icon-eye-off" viewBox="0 0 24 24" aria-hidden="true" hidden>
                            <path d="M17.94 17.94A10.07 10.07 0 0 1 12 20c-7 0-11-8-11-8a18.45 18.45 0 0 1 5.06-5.94M9.9 4.24A9.12 9.12 0 0 1 12 4c7 0 11 8 11 8a18.5 18.5 0 0 1-2.16 3.19m-6.72-1.07a3 3 0 1 1-4.24-4.24" />
                            <line x1="1" y1="1" x2="23" y2="23" />
                        </svg>
                    </button>
                </div>
            </label>

            <label class="va-field">
                <span class="va-field-label">Phone</span>
                <input type="tel"
                       name="Form.PhoneNumber"
                       value="@Model.Form.PhoneNumber"
                       class="va-input" />
            </label>
        </div>

        <label class="va-checkbox">
            @{
                var emailConfirmedChecked = Model.Form.EmailConfirmed ? "checked" : null;
            }
            <input type="checkbox"
                   name="Form.EmailConfirmed"
                   value="true"
                   checked="@emailConfirmedChecked" />
            <span>Email already verified (skip the confirmation flow)</span>
        </label>

        @if (Model.Capabilities.SupportsRoleManagement && Model.AvailableRoles.Count > 0)
        {
            <fieldset class="va-fieldset">
                <legend class="va-field-label">Roles</legend>
                <p class="va-muted va-empty-inline">
                    Select the roles the new user should land in. You can change
                    these later from the user detail page.
                </p>
                <div class="va-checkbox-grid">
                    @foreach (var role in Model.AvailableRoles)
                    {
                        var isChecked = Model.Form.SelectedRoles.Contains(role.Name, StringComparer.OrdinalIgnoreCase) ? "checked" : null;
                        <label class="va-checkbox">
                            <input type="checkbox"
                                   name="Form.SelectedRoles"
                                   value="@role.Name"
                                   checked="@isChecked" />
                            <span>@role.Name</span>
                        </label>
                    }
                </div>
            </fieldset>
        }

        <div class="va-form-actions">
            <button type="submit" class="va-btn va-btn-primary">Create user</button>
            <a class="va-btn va-btn-ghost" href="/visuauth/admin/users">Cancel</a>
        </div>
    </form>
</section>
