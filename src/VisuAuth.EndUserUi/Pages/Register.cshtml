@page "/visuauth/register"
@model VisuAuth.EndUserUi.Pages.RegisterModel
@{
    Layout = "_EndUserLayout";
    ViewData["Title"] = Ls["Register.PageTitle"].Value;
}

<h1 class="va-enduser-heading">@Ls["Register.Heading"]</h1>
<p class="va-enduser-subtitle">@Ls["Register.Subtitle"]</p>

<va-form-errors errors="@Model.Errors" lead="@Ls["Register.ErrorLead"].Value" />

@if (Model.CreatedUserId is { Length: > 0 })
{
    <div class="va-alert va-alert-success" role="status">
        <p><strong>@Ls["Register.Created"]</strong> @L["Register.CanSignInNow"]</p>
        @if (Model.ConfirmationLink is { Length: > 0 } link)
        {
            <p>@L["Register.ConfirmLinkDev", link]</p>
        }
    </div>
}

@if (Model.Capabilities.SupportsRegistration)
{
    <form method="post" asp-page="/Register" class="va-enduser-form" autocomplete="on">
        @Html.AntiForgeryToken()

        <label class="va-field">
            <span class="va-field-label">@Ls["Common.LabelEmail"]</span>
            <input type="email"
                   name="Form.Email"
                   value="@Model.Form.Email"
                   class="va-input"
                   autocomplete="email"
                   required
                   autofocus />
        </label>

        <va-password name="Form.Password" autocomplete="new-password" />
        <va-password name="Form.ConfirmPassword" label="@Ls["Register.ConfirmPasswordLabel"].Value" autocomplete="new-password" />

        <button type="submit" class="va-btn va-btn-primary">@Ls["Register.Submit"]</button>
    </form>
}

<div class="va-enduser-footer">
    @Ls["Register.AlreadyHave"] <a href="/visuauth/login">@Ls["Register.SignInLink"]</a>
</div>
