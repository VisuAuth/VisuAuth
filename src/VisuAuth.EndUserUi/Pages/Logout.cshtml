@page "/visuauth/logout"
@model VisuAuth.EndUserUi.Pages.LogoutModel
@{
    Layout = "_EndUserLayout";
    ViewData["Title"] = Ls["Logout.PageTitle"].Value;
}

<h1 class="va-enduser-heading">@Ls["Logout.Heading"]</h1>
<p class="va-enduser-subtitle">@Ls["Logout.Subtitle"]</p>

<form method="post" asp-page="/Logout" class="va-enduser-form">
    @Html.AntiForgeryToken()
    <input type="hidden" name="returnUrl" value="@Model.ReturnUrl" />
    <button type="submit" class="va-btn va-btn-primary">@Ls["Logout.Submit"]</button>
</form>

<div class="va-enduser-footer">
    <a href="/">@Ls["Logout.BackToApp"]</a>
</div>
