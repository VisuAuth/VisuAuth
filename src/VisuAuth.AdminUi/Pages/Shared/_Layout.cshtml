@using VisuAuth.Abstractions.Tenancy
@inject ITenantContext TenantContext
@inject IServiceProvider Services
@{
    var title = ViewData["Title"] as string ?? Ls["Users.PageTitle"].Value;
    // Tenant catalogue is only registered when the consumer calls the generic
    // EnableVisuAuthTenancy overload, so reach for it via the service locator
    // rather than @inject so single-tenant deployments stay happy.
    var tenantStore = TenantContext.IsMultiTenancyEnabled
        ? Services.GetService(typeof(ITenantStore)) as ITenantStore
        : null;
    var sidebarTenants = tenantStore is null
        ? Array.Empty<TenantSummary>()
        : (IReadOnlyList<TenantSummary>)await tenantStore.ListAsync();
    var currentPath = Context.Request.Path + Context.Request.QueryString;
    var pageLang = System.Globalization.CultureInfo.CurrentUICulture.Name;
}<!doctype html>
<html lang="@pageLang">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>@title</title>
    @* asp-append-version pins ?v={file-hash}, so a stylesheet rebuild forces
       browsers to fetch the new content instead of serving a stale cached copy. *@
    <link rel="stylesheet" href="/_content/VisuAuth.AdminUi/visuauth.css" asp-append-version="true" />
    @* Programmatic theme overrides (CLAUDE.md §8.4 layer 2). Tag helper
       suppresses itself when no VisuAuthTheme properties were configured,
       so the markup stays clean for the default-theme case. Placed AFTER
       the stylesheet link so overrides win on source order. *@
    <va-theme-style />
    @* htmx is shipped as an embedded static asset so air-gapped
       deployments work out of the box (no outbound CDN call). The file
       at wwwroot/htmx.min.js is htmx 2.0.4 verbatim — keep it in sync
       when bumping the version. *@
    <script src="/_content/VisuAuth.AdminUi/htmx.min.js" asp-append-version="true" defer></script>
    <script src="/_content/VisuAuth.AdminUi/visuauth.js" asp-append-version="true" defer></script>
</head>
<body>
    <div class="va-shell">
        @{
            // Highlight the sidebar entry that matches the current URL. Razor
            // partials inherit the host request, so Request.Path is the live URL.
            var path = Context.Request.Path.Value ?? string.Empty;
            string NavClass(string segment) =>
                path.StartsWith(segment, StringComparison.OrdinalIgnoreCase) ? "va-active" : "";
        }
        <aside class="va-sidebar">
            <a class="va-brand" href="/visuauth/admin/users">VisuAuth</a>
            @if (TenantContext.IsMultiTenancyEnabled)
            {
                @* asp-page + asp-page-handler engage the form tag helper so the
                   antiforgery token is auto-injected. The explicit
                   @Html.AntiForgeryToken() is belt-and-suspenders for any case
                   where the helper does not run (rare, but cheap insurance —
                   the sidebar renders on every admin page, so missing tokens
                   here would brick the switcher for browser users). *@
                <form method="post"
                      asp-page="/Admin/Tenants/Index"
                      asp-page-handler="Switch"
                      class="va-tenant-indicator">
                    @Html.AntiForgeryToken()
                    <span class="va-field-label">@Ls["Sidebar.TenantScope"]</span>
                    <input type="hidden" name="returnUrl" value="@currentPath" />
                    <select name="tenantId"
                            class="va-input va-tenant-switcher"
                            onchange="this.form.submit();">
                        <option value="" selected="@(string.IsNullOrEmpty(TenantContext.CurrentTenantId) ? "selected" : null)">@Ls["Sidebar.TenantGlobal"]</option>
                        @foreach (var tenant in sidebarTenants)
                        {
                            <option value="@tenant.Id" selected="@(string.Equals(tenant.Id, TenantContext.CurrentTenantId, StringComparison.Ordinal) ? "selected" : null)">
                                @tenant.DisplayName
                            </option>
                        }
                    </select>
                    <noscript>
                        <button type="submit" class="va-btn va-btn-small va-btn-ghost">@Ls["Sidebar.TenantApply"]</button>
                    </noscript>
                </form>
            }
            <nav class="va-nav">
                <a href="/visuauth/admin/users" class="@NavClass("/visuauth/admin/users")">@Ls["Sidebar.NavUsers"]</a>
                <a href="/visuauth/admin/roles" class="@NavClass("/visuauth/admin/roles")">@Ls["Sidebar.NavRoles"]</a>
                @if (TenantContext.IsMultiTenancyEnabled)
                {
                    <a href="/visuauth/admin/tenants" class="@NavClass("/visuauth/admin/tenants")">@Ls["Sidebar.NavTenants"]</a>
                }
                else
                {
                    <a href="#" aria-disabled="true" class="va-muted">@Ls["Sidebar.NavTenantsSoon"]</a>
                }
                <a href="/visuauth/admin/external-providers" class="@NavClass("/visuauth/admin/external-providers")">@Ls["Sidebar.NavExternalProviders"]</a>
                <a href="/visuauth/admin/audit-log" class="@NavClass("/visuauth/admin/audit-log")">@Ls["Sidebar.NavAuditLog"]</a>
            </nav>
            @* Language switcher (CLAUDE.md §10.1). The tag helper suppresses
               itself when only one culture is configured, so the markup
               stays clean for single-language deployments. *@
            <va-language-switcher class="va-tenant-indicator" />
        </aside>
        <main class="va-main">
            @RenderBody()
        </main>
    </div>
</body>
</html>
