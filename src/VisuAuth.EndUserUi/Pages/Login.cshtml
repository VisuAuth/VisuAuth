@page "/visuauth/login"
@model VisuAuth.EndUserUi.Pages.LoginModel
@{
    ViewData["Title"] = "Sign in — VisuAuth";
}

<h1 class="va-enduser-heading">Sign in</h1>
<p class="va-enduser-subtitle">Use your email and password to continue.</p>

@if (Model.ErrorMessage is { Length: > 0 } error)
{
    <div class="va-alert va-alert-danger" role="alert">@error</div>
}

@if (Model.Capabilities.SupportsLocalLogin)
{
    <form method="post" asp-page="/Login" class="va-enduser-form" autocomplete="on">
        @Html.AntiForgeryToken()
        <input type="hidden" name="returnUrl" value="@Model.ReturnUrl" />

        <label class="va-field">
            <span class="va-field-label">Email</span>
            <input type="email"
                   name="Form.Email"
                   value="@Model.Form.Email"
                   class="va-input"
                   autocomplete="username"
                   required
                   autofocus />
        </label>

        <label class="va-field">
            <span class="va-field-label">Password</span>
            <input type="password"
                   name="Form.Password"
                   class="va-input"
                   autocomplete="current-password"
                   required />
        </label>

        <label class="va-checkbox">
            @{ var rememberChecked = Model.Form.RememberMe ? "checked" : null; }
            <input type="checkbox" name="Form.RememberMe" value="true" checked="@rememberChecked" />
            <span>Keep me signed in on this device</span>
        </label>

        <button type="submit" class="va-btn va-btn-primary">Sign in</button>
    </form>

    <div class="va-enduser-footer">
        <a href="#" aria-disabled="true" class="va-muted">Forgot password? (soon)</a>
        &middot;
        <a href="#" aria-disabled="true" class="va-muted">Create account (soon)</a>
    </div>
}
else
{
    <p class="va-enduser-subtitle">
        Sign-in is delegated to an external identity provider. A follow-up
        PR wires the "Sign in with Microsoft" button here.
    </p>
}
