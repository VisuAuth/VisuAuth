@page "/visuauth/admin/tenants"
@model VisuAuth.AdminUi.Pages.Admin.Tenants.IndexModel
@{
    ViewData["Title"] = Ls["Tenants.PageTitle"].Value;
}

<div class="va-page-header">
    <h1>@Ls["Tenants.Title"] <span class="va-muted" style="font-weight:400;font-size:1rem;">(@Model.Tenants.Count)</span></h1>
</div>

<div id="va-tenants-catalogue">
    <partial name="_TenantsCatalogue" model="Model" />
</div>
