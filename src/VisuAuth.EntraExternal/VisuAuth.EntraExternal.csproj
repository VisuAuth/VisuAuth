<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>VisuAuth.EntraExternal</RootNamespace>
    <AssemblyName>VisuAuth.EntraExternal</AssemblyName>
  </PropertyGroup>

  <PropertyGroup Label="NuGet">
    <PackageId>VisuAuth.EntraExternal</PackageId>
    <Title>VisuAuth Microsoft Entra External ID Adapter</Title>
    <Description>Microsoft Entra External ID (formerly Azure AD B2C) adapter for VisuAuth: implements IUserStore, IRoleStore, and IAuthenticationFlow against the Microsoft Graph API using app-only (client credentials) auth. Targets customer-facing tenants where end users sign in with an email + password local account managed by Microsoft. Declares SupportsLocalLogin = false so VisuAuth's end-user UI surfaces the hosted Microsoft login while the admin UI manages users / roles directly against Graph.</Description>
    <PackageTags>visuauth;entra;external-id;ciam;b2c;graph;adapter;identity</PackageTags>
    <PackageReadmeFile>README.md</PackageReadmeFile>
  </PropertyGroup>

  <ItemGroup>
    <!-- Adapter-specific README so the nuget.org page shows the External ID
         setup walkthrough directly, instead of the generic repo overview. -->
    <None Include="README.md" Pack="true" PackagePath="\" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\VisuAuth.Abstractions\VisuAuth.Abstractions.csproj" />
    <!-- EntraCore hosts the shared GraphServiceClient factory, the no-op
         stubs (IAuditWriter / IJwtIssuer / ITenantContext / IExternalLoginFlow)
         that an Entra-only deployment needs, and the CSPRNG temporary-password
         generator. We deliberately do NOT reference VisuAuth.Entra — Workforce
         and External are sibling adapters with no upstream / downstream
         relationship (CLAUDE.md §2.5). -->
    <ProjectReference Include="..\VisuAuth.EntraCore\VisuAuth.EntraCore.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- Microsoft.Graph + Azure.Identity also flow in transitively via
         EntraCore; the explicit references here are belt-and-suspenders
         for code in THIS package that calls them directly (Graph types
         in EntraExternalUserStore / EntraExternalRoleStore). -->
    <PackageReference Include="Microsoft.Graph" />
    <PackageReference Include="Azure.Identity" />
    <PackageReference Include="Microsoft.Extensions.Options.ConfigurationExtensions" />
    <PackageReference Include="Microsoft.Extensions.Options.DataAnnotations" />
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" />
  </ItemGroup>

  <ItemGroup Label="Test access">
    <InternalsVisibleTo Include="VisuAuth.UnitTests" />
  </ItemGroup>

</Project>
