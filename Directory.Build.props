<Project>

  <PropertyGroup Label="Language">
    <TargetFramework Condition="'$(TargetFramework)' == ''">net10.0</TargetFramework>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <EnforceCodeStyleInBuild>true</EnforceCodeStyleInBuild>
    <AnalysisLevel>latest-recommended</AnalysisLevel>
  </PropertyGroup>

  <PropertyGroup Label="Build">
    <DebugType>embedded</DebugType>
    <ContinuousIntegrationBuild Condition="'$(GITHUB_ACTIONS)' == 'true'">true</ContinuousIntegrationBuild>
    <NeutralLanguage>en-US</NeutralLanguage>
  </PropertyGroup>

  <PropertyGroup Label="Package metadata shared across all VisuAuth.* packages">
    <Authors>Thiago Luga</Authors>
    <Company>VisuAuth</Company>
    <Product>VisuAuth</Product>
    <Copyright>Copyright (c) 2026 Thiago Luga and VisuAuth contributors</Copyright>
    <PackageProjectUrl>https://github.com/VisuAuth/visuauth</PackageProjectUrl>
    <RepositoryUrl>https://github.com/VisuAuth/visuauth</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageLicenseExpression>Apache-2.0</PackageLicenseExpression>
    <PackageRequireLicenseAcceptance>false</PackageRequireLicenseAcceptance>
    <PublishRepositoryUrl>true</PublishRepositoryUrl>
    <EmbedUntrackedSources>true</EmbedUntrackedSources>
    <!--
      A single PackageReleaseNotes line shared by every VisuAuth.* package.
      We point at the CHANGELOG instead of inlining the notes so the NuGet
      gallery and the source of truth never drift. The link survives both
      pre-releases (off main) and stable tags because /blob/main/CHANGELOG.md
      always renders the latest entries.
    -->
    <PackageReleaseNotes>See https://github.com/VisuAuth/visuauth/blob/main/CHANGELOG.md for release notes.</PackageReleaseNotes>
  </PropertyGroup>

  <PropertyGroup Label="Version">
    <!--
      Single source of truth for the VisuAuth.* package version.

      CI picks the channel:
        - Tag push `v0.3.0`           → `dotnet pack -p:Version=0.3.0`                    → stable 0.3.0
        - Push to main (merge)       → `dotnet pack -p:VersionSuffix=alpha.<run_number>` → 0.3.0-alpha.<run_number> (pre-release)
        - Local dev                  → falls back to 0.3.0-alpha.local

      Bump `VersionPrefix` when starting work on the next minor / major.
      (0.2.0 shipped on the v0.2.0 tag; main now tracks 0.3.0 pre-releases.)
    -->
    <VersionPrefix>0.3.0</VersionPrefix>
    <VersionSuffix Condition="'$(VersionSuffix)' == ''">alpha.local</VersionSuffix>
  </PropertyGroup>

  <ItemGroup Label="SourceLink">
    <PackageReference Include="Microsoft.SourceLink.GitHub" PrivateAssets="All" Condition="'$(IsPackable)' != 'false'" />
  </ItemGroup>

</Project>
