@page "/visuauth/register"
@model VisuAuth.EndUserUi.Pages.RegisterModel
@{
    Layout = "_EndUserLayout";
    ViewData["Title"] = "Create account — VisuAuth";
}

<h1 class="va-enduser-heading">Create account</h1>
<p class="va-enduser-subtitle">Sign up to access the application.</p>

@if (Model.Errors.Count > 0)
{
    <div class="va-alert va-alert-danger" role="alert">
        <strong>We could not create your account.</strong>
        <ul>
            @foreach (var err in Model.Errors)
            {
                <li>@err</li>
            }
        </ul>
    </div>
}

@if (Model.CreatedUserId is { Length: > 0 })
{
    <div class="va-alert va-alert-success" role="status">
        <p><strong>Account created.</strong> You can <a href="/visuauth/login">sign in</a> now.</p>
        @if (Model.ConfirmationLink is { Length: > 0 } link)
        {
            <p>
                Development mode: to verify the email address, the user would
                receive a link similar to <a href="@link"><code>@link</code></a>.
                The matching page would carry the email confirmation token in
                the URL.
            </p>
        }
    </div>
}

@if (Model.Capabilities.SupportsRegistration)
{
    <form method="post" asp-page="/Register" class="va-enduser-form" autocomplete="on">
        @Html.AntiForgeryToken()

        <label class="va-field">
            <span class="va-field-label">Email</span>
            <input type="email"
                   name="Form.Email"
                   value="@Model.Form.Email"
                   class="va-input"
                   autocomplete="email"
                   required
                   autofocus />
        </label>

        <label class="va-field">
            <span class="va-field-label">Password</span>
            <div class="va-password-wrap">
                <input type="password"
                       name="Form.Password"
                       class="va-input"
                       autocomplete="new-password"
                       required />
                <button type="button"
                        class="va-password-toggle"
                        data-va-password-toggle
                        aria-label="Show password"
                        aria-pressed="false">
                    <svg class="va-icon-eye" viewBox="0 0 24 24" aria-hidden="true">
                        <path d="M1 12s4-8 11-8 11 8 11 8-4 8-11 8-11-8-11-8z" />
                        <circle cx="12" cy="12" r="3" />
                    </svg>
                    <svg class="va-icon-eye-off" viewBox="0 0 24 24" aria-hidden="true" hidden>
                        <path d="M17.94 17.94A10.07 10.07 0 0 1 12 20c-7 0-11-8-11-8a18.45 18.45 0 0 1 5.06-5.94M9.9 4.24A9.12 9.12 0 0 1 12 4c7 0 11 8 11 8a18.5 18.5 0 0 1-2.16 3.19m-6.72-1.07a3 3 0 1 1-4.24-4.24" />
                        <line x1="1" y1="1" x2="23" y2="23" />
                    </svg>
                </button>
            </div>
        </label>

        <label class="va-field">
            <span class="va-field-label">Confirm password</span>
            <div class="va-password-wrap">
                <input type="password"
                       name="Form.ConfirmPassword"
                       class="va-input"
                       autocomplete="new-password"
                       required />
                <button type="button"
                        class="va-password-toggle"
                        data-va-password-toggle
                        aria-label="Show password"
                        aria-pressed="false">
                    <svg class="va-icon-eye" viewBox="0 0 24 24" aria-hidden="true">
                        <path d="M1 12s4-8 11-8 11 8 11 8-4 8-11 8-11-8-11-8z" />
                        <circle cx="12" cy="12" r="3" />
                    </svg>
                    <svg class="va-icon-eye-off" viewBox="0 0 24 24" aria-hidden="true" hidden>
                        <path d="M17.94 17.94A10.07 10.07 0 0 1 12 20c-7 0-11-8-11-8a18.45 18.45 0 0 1 5.06-5.94M9.9 4.24A9.12 9.12 0 0 1 12 4c7 0 11 8 11 8a18.5 18.5 0 0 1-2.16 3.19m-6.72-1.07a3 3 0 1 1-4.24-4.24" />
                        <line x1="1" y1="1" x2="23" y2="23" />
                    </svg>
                </button>
            </div>
        </label>

        <button type="submit" class="va-btn va-btn-primary">Create account</button>
    </form>
}

<div class="va-enduser-footer">
    Already have an account? <a href="/visuauth/login">Sign in</a>
</div>
