<Project>

  <PropertyGroup>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
    <CentralPackageTransitivePinningEnabled>true</CentralPackageTransitivePinningEnabled>
  </PropertyGroup>

  <ItemGroup Label="ASP.NET Core / Identity">
    <PackageVersion Include="Microsoft.AspNetCore.Identity.EntityFrameworkCore" Version="10.0.0" />
    <PackageVersion Include="Microsoft.AspNetCore.Identity.UI" Version="10.0.0" />
    <PackageVersion Include="Microsoft.EntityFrameworkCore" Version="10.0.0" />
    <PackageVersion Include="Microsoft.EntityFrameworkCore.Sqlite" Version="10.0.0" />
    <PackageVersion Include="Microsoft.EntityFrameworkCore.SqlServer" Version="10.0.0" />
    <PackageVersion Include="Microsoft.EntityFrameworkCore.Design" Version="10.0.0" />
    <PackageVersion Include="Microsoft.EntityFrameworkCore.InMemory" Version="10.0.0" />
  </ItemGroup>

  <ItemGroup Label="Extensions">
    <!-- 10.0.7 pins are floor-bumped to satisfy Microsoft.Identity.Web 4.10's
         transitive demand (it pulls Microsoft.AspNetCore.DataProtection
         10.0.7 which in turn requires DI / Logging abstractions 10.0.7+).
         Identical patch-level versions across the .NET 10 servicing branch
         — no behaviour change for the packages that don't pull
         MS.Identity.Web in. -->
    <PackageVersion Include="Microsoft.Extensions.Logging.Abstractions" Version="10.0.7" />
    <PackageVersion Include="Microsoft.Extensions.DependencyInjection.Abstractions" Version="10.0.7" />
    <PackageVersion Include="Microsoft.Extensions.Options.ConfigurationExtensions" Version="10.0.0" />
  </ItemGroup>

  <ItemGroup Label="Localization">
    <PackageVersion Include="My.Extensions.Localization.Json" Version="4.0.0" />
  </ItemGroup>

  <ItemGroup Label="JWT">
    <PackageVersion Include="Microsoft.AspNetCore.Authentication.JwtBearer" Version="10.0.0" />
    <!-- 8.18.0 minimum because Microsoft.Identity.Web 4.10 transitively
         requires it. Previously pinned at 8.14.0 for AspNet.Security.OAuth.Apple
         10.0.0; the bump is safe because 8.18 is fully backward-compatible
         with 8.14 (servicing patches on the same major). Central Package
         Management forces us to track the highest transitive constraint. -->
    <PackageVersion Include="System.IdentityModel.Tokens.Jwt" Version="8.18.0" />
  </ItemGroup>

  <ItemGroup Label="External providers (sample only)">
    <!-- Used by Sample.WebApp to wire external login providers conditionally
         when the consumer fills in ClientId/ClientSecret. Not pulled in by
         the VisuAuth packages themselves — adapter contracts stay agnostic.
         Microsoft / Google are shipped by the ASP.NET Core team; Apple /
         GitHub use the community AspNet.Security.OAuth.Providers project
         (https://github.com/aspnet-contrib/AspNet.Security.OAuth.Providers). -->
    <PackageVersion Include="Microsoft.AspNetCore.Authentication.MicrosoftAccount" Version="10.0.0" />
    <PackageVersion Include="Microsoft.AspNetCore.Authentication.Google" Version="10.0.0" />
    <PackageVersion Include="Microsoft.AspNetCore.Authentication.Facebook" Version="10.0.0" />
    <PackageVersion Include="AspNet.Security.OAuth.Apple" Version="10.0.0" />
    <PackageVersion Include="AspNet.Security.OAuth.GitHub" Version="10.0.0" />
  </ItemGroup>

  <ItemGroup Label="Microsoft Entra ID (VisuAuth.Entra)">
    <!-- Microsoft Graph SDK is the only sensible way to call Graph from .NET —
         the REST shapes change often and Kiota-generated clients track them.
         Azure.Identity supplies ClientSecretCredential for the app-only
         (client credentials) auth flow the Entra adapter uses. Both are
         scoped to VisuAuth.Entra; the Identity adapter does not pull them in. -->
    <PackageVersion Include="Microsoft.Graph" Version="5.95.0" />
    <!-- 1.17.2 floor needed by Microsoft.Identity.Web 4.10's transitive
         Microsoft.Identity.Web.Certificate. Was 1.13.1 (the original Graph
         adapter's pin); the bump is patch-level safe across the 1.x line
         and unifies the credential implementation across both adapters. -->
    <PackageVersion Include="Azure.Identity" Version="1.17.2" />
    <!-- Microsoft.Identity.Web wraps OpenIdConnect + Cookies for sign-in
         against Microsoft identity authorities (Workforce + External). Only
         pulled in by VisuAuth.EntraExternal.Web (the opt-in sub-package
         that ships the End-user OIDC bridge) — the CRUD-only Entra +
         EntraExternal adapters stay free of it so consumers who don't need
         the hosted login flow don't pay the dependency weight. -->
    <PackageVersion Include="Microsoft.Identity.Web" Version="4.10.0" />
    <!-- Adds ValidateDataAnnotations() to OptionsBuilder. ASP.NET hosting
         pulls this in transitively in web apps; standalone class libraries
         like VisuAuth.Entra have to opt in. -->
    <PackageVersion Include="Microsoft.Extensions.Options.DataAnnotations" Version="10.0.0" />
    <!-- Pin Kiota above the GHSA-7j59-v9qr-6fq9 fix. Microsoft.Graph 5.95
         transitively pulls 1.17.1 which is vulnerable; central package
         management lets us override the transitive without touching the
         Graph reference itself. Remove when Graph's transitive constraint
         catches up. -->
    <PackageVersion Include="Microsoft.Kiota.Abstractions" Version="1.22.0" />
  </ItemGroup>

  <ItemGroup Label="TOTP">
    <!-- QR-code generator (pure-managed, MIT) used by the end-user TOTP setup
         page to render the otpauth:// URI as an inline SVG. Picked over rolling
         Reed-Solomon by hand because the library is small, dependency-free,
         and well-trodden in the .NET ecosystem. -->
    <PackageVersion Include="QRCoder" Version="1.6.0" />
  </ItemGroup>

  <ItemGroup Label="SourceLink">
    <PackageVersion Include="Microsoft.SourceLink.GitHub" Version="8.0.0" />
  </ItemGroup>

  <ItemGroup Label="Testing">
    <PackageVersion Include="Microsoft.NET.Test.Sdk" Version="17.11.1" />
    <PackageVersion Include="xunit" Version="2.9.2" />
    <PackageVersion Include="xunit.runner.visualstudio" Version="2.8.2" />
    <PackageVersion Include="FluentAssertions" Version="6.12.1" />
    <PackageVersion Include="Moq" Version="4.20.72" />
    <PackageVersion Include="Microsoft.Extensions.TimeProvider.Testing" Version="9.0.0" />
    <PackageVersion Include="Microsoft.AspNetCore.Mvc.Testing" Version="10.0.0" />
    <PackageVersion Include="coverlet.collector" Version="6.0.2" />
  </ItemGroup>

</Project>
