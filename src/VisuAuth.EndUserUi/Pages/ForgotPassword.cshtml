@page "/visuauth/forgot-password"
@model VisuAuth.EndUserUi.Pages.ForgotPasswordModel
@{
    Layout = "_EndUserLayout";
    ViewData["Title"] = "Forgot password — VisuAuth";
}

<h1 class="va-enduser-heading">Forgot password</h1>
<p class="va-enduser-subtitle">Enter your account email and we'll send you reset instructions.</p>

@if (ViewData.ModelState.ErrorCount > 0 && !Model.Submitted)
{
    <div class="va-alert va-alert-danger" role="alert">
        <ul>
            @foreach (var entry in ViewData.ModelState.Values.SelectMany(v => v.Errors))
            {
                <li>@entry.ErrorMessage</li>
            }
        </ul>
    </div>
}

@if (Model.Submitted)
{
    <div class="va-alert va-alert-success" role="status">
        <p>
            If an account exists for that email, you'll receive password reset
            instructions shortly.
        </p>
        @if (Model.ResetLink is { Length: > 0 } link)
        {
            <p>
                Development mode: the reset link below is what would normally
                arrive by email. Click to continue.
            </p>
            <p><a href="@link"><code>@link</code></a></p>
        }
    </div>
}
else if (Model.Capabilities.SupportsPasswordReset)
{
    <form method="post" asp-page="/ForgotPassword" class="va-enduser-form" autocomplete="on">
        @Html.AntiForgeryToken()

        <label class="va-field">
            <span class="va-field-label">Email</span>
            <input type="email"
                   name="Form.Email"
                   value="@Model.Form.Email"
                   class="va-input"
                   autocomplete="email"
                   required
                   autofocus />
        </label>

        <button type="submit" class="va-btn va-btn-primary">Send reset instructions</button>
    </form>
}
else
{
    <p class="va-enduser-subtitle">
        Password reset is not supported by this backend.
    </p>
}

<div class="va-enduser-footer">
    <a href="/visuauth/login">Back to sign in</a>
</div>
