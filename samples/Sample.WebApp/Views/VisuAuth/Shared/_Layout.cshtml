@*
    VisuAuth admin layout — FULL design-system version with the top header bar.
    Brings the real product up to the prototype's chrome:
      • top header: brand mark · language · icon theme toggle · user/account menu
      • sidebar: collapse toggle + icon nav + tenant switcher (pinned bottom)

    Built from the package layout (src/VisuAuth.AdminUi/Pages/Shared/_Layout.cshtml).
    Everything is wrapped in `.va-app`, which restores --visuauth-header-h to 56px
    so the new visuauth.css tucks the sticky sidebar beneath the header. All Razor
    logic (@Ls keys, @NavClass, tenant form, tag helpers) is preserved.

    The account menu is a native <details> (works with no JS). va-header.js adds
    outside-click/Esc close + the sidebar collapse toggle. va-theme-init.js drives
    the theme toggle. Sign-out points to /visuauth/logout (GET → confirm page).

    If you prefer NO top header (keep everything in the sidebar), use the
    sidebar-only layout from the previous handoff instead — the CSS supports both.
*@
@using VisuAuth.Abstractions.Authentication
@using VisuAuth.Abstractions.Tenancy
@using System.Security.Claims
@using Microsoft.Extensions.Localization
@inject ITenantContext TenantContext
@inject IServiceProvider Services
@{
    var title = ViewData["Title"] as string ?? Ls["Users.PageTitle"].Value;
    var tenantStore = TenantContext.IsMultiTenancyEnabled
        ? Services.GetService(typeof(ITenantStore)) as ITenantStore
        : null;
    var sidebarTenants = tenantStore is null
        ? Array.Empty<TenantSummary>()
        : (IReadOnlyList<TenantSummary>)await tenantStore.ListAsync();
    var currentPath = Context.Request.Path + Context.Request.QueryString;
    var pageLang = System.Globalization.CultureInfo.CurrentUICulture.Name;
    var externalProvidersAvailable =
        Services.GetService(typeof(IExternalProviderConfigStore)) is not null;
    var adapterConfigAvailable =
        Services.GetService(typeof(VisuAuth.Abstractions.Configuration.IAdapterConfigStore)) is not null
        && Services.GetService(typeof(IEnumerable<VisuAuth.Abstractions.Configuration.IAdapterConfigSchema>))
            is IEnumerable<VisuAuth.Abstractions.Configuration.IAdapterConfigSchema> schemas
        && schemas.Any();

    // Header account card — current admin identity.
    var displayName = User?.Identity?.Name ?? "Account";
    var roleLabel = User?.FindFirst(ClaimTypes.Role)?.Value;
    string Initials(string name)
    {
        var parts = (name ?? "").Split(new[] { ' ', '.', '@', '_', '-' }, StringSplitOptions.RemoveEmptyEntries);
        if (parts.Length == 0) return "?";
        if (parts.Length == 1) return parts[0].Substring(0, Math.Min(2, parts[0].Length)).ToUpperInvariant();
        return (parts[0].Substring(0, 1) + parts[1].Substring(0, 1)).ToUpperInvariant();
    }
    var initials = Initials(displayName);

    // Safe localization: fall back to clean English if a key isn't in the JSON
    // localizer (AdminSharedResources.*.json) yet (Account.SignOut /
    // Sidebar.Collapse are new — see README to add them).
    string Loc(LocalizedString s, string fallback) => s.ResourceNotFound ? fallback : s.Value;
}<!doctype html>
<html lang="@pageLang">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>@title</title>
    <link rel="stylesheet" href="/_content/VisuAuth.AdminUi/visuauth.css" asp-append-version="true" />
    <va-theme-style />
    <script src="/_content/VisuAuth.AdminUi/htmx.min.js" asp-append-version="true" defer></script>
    <script src="/_content/VisuAuth.AdminUi/visuauth.js" asp-append-version="true" defer></script>
    @* Theme initializer — synchronous (no defer) so the stored choice applies before paint. *@
    <script src="/_content/VisuAuth.AdminUi/va-theme-init.js" asp-append-version="true"></script>
    @* Header enhancements (account menu close + sidebar collapse) — progressive. *@
    <script src="/_content/VisuAuth.AdminUi/va-header.js" asp-append-version="true" defer></script>
</head>
<body>
    <div class="va-app">
        @{
            var path = Context.Request.Path.Value ?? string.Empty;
            string NavClass(string segment) =>
                path.StartsWith(segment, StringComparison.OrdinalIgnoreCase) ? "va-active" : "";
            string DashboardNavClass() =>
                string.Equals(path, "/visuauth/admin", StringComparison.OrdinalIgnoreCase)
                || string.Equals(path, "/visuauth/admin/", StringComparison.OrdinalIgnoreCase)
                    ? "va-active" : "";
        }
        <header class="va-header">
            <div class="va-header-group">
                <a class="va-brand" href="/visuauth/admin">
                    <span class="va-brand-mark" aria-hidden="true">V</span>
                    <span>VisuAuth</span>
                </a>
                @if (TenantContext.IsMultiTenancyEnabled)
                {
                    @* Tenant switcher in the header (design-system parity): sits
                       beside the brand instead of at the foot of the sidebar.
                       Keeps the va-tenant-indicator class so the same
                       POST-to-Switch handler applies; the .va-header scope in
                       visuauth.css overrides the sidebar column layout. *@
                    <form method="post"
                          asp-page="/Admin/Tenants/Index"
                          asp-page-handler="Switch"
                          class="va-tenant-indicator va-header-tenant">
                        @Html.AntiForgeryToken()
                        <input type="hidden" name="returnUrl" value="@currentPath" />
                        <select name="tenantId"
                                class="va-input va-tenant-switcher"
                                aria-label="@Ls["Sidebar.TenantScope"]"
                                onchange="this.form.submit();">
                            <option value="" selected="@(string.IsNullOrEmpty(TenantContext.CurrentTenantId) ? "selected" : null)">@Ls["Sidebar.TenantGlobal"]</option>
                            @foreach (var tenant in sidebarTenants)
                            {
                                <option value="@tenant.Id" selected="@(string.Equals(tenant.Id, TenantContext.CurrentTenantId, StringComparison.Ordinal) ? "selected" : null)">
                                    @tenant.DisplayName
                                </option>
                            }
                        </select>
                        <noscript>
                            <button type="submit" class="va-btn va-btn-small va-btn-ghost">@Ls["Sidebar.TenantApply"]</button>
                        </noscript>
                    </form>
                }
            </div>
            <div class="va-header-group">
                <va-language-switcher />
                <button type="button" class="va-btn va-btn-ghost va-header-theme" data-va-theme-toggle aria-label="@Ls["Sidebar.ThemeToggle"]">
                    <svg class="va-icon-moon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79z"/></svg>
                    <svg class="va-icon-sun" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="12" cy="12" r="4"/><path d="M12 2v2M12 20v2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M2 12h2M20 12h2M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4"/></svg>
                </button>
                <div class="va-header-sep"></div>
                <div class="va-user-wrap">
                    <details class="va-user-details">
                        <summary class="va-user">
                            <span class="va-avatar" aria-hidden="true">@initials</span>
                            <span class="va-user-meta">
                                <span class="va-user-name">@displayName</span>
                                @if (!string.IsNullOrEmpty(roleLabel))
                                {
                                    <span class="va-user-role">@roleLabel</span>
                                }
                            </span>
                            <span class="va-user-caret" aria-hidden="true">
                                <svg viewBox="0 0 24 24" width="14" height="14" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="6 9 12 15 18 9"/></svg>
                            </span>
                        </summary>
                        <div class="va-user-menu" role="menu">
                            <div class="va-user-menu-head">
                                <span class="va-avatar" aria-hidden="true">@initials</span>
                                <span class="va-user-meta">
                                    <span class="va-user-name">@displayName</span>
                                    @if (!string.IsNullOrEmpty(roleLabel))
                                    {
                                        <span class="va-user-role">@roleLabel</span>
                                    }
                                </span>
                            </div>
                            <div class="va-menu-sep"></div>
                            <a class="va-menu-item va-menu-item-danger" role="menuitem" href="/visuauth/logout?returnUrl=/visuauth/admin">
                                <svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M9 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h4"/><polyline points="16 17 21 12 16 7"/><line x1="21" y1="12" x2="9" y2="12"/></svg>
                                <span>@Loc(Ls["Account.SignOut"], "Sign out")</span>
                            </a>
                        </div>
                    </details>
                </div>
            </div>
        </header>

        <div class="va-shell">
            <aside class="va-sidebar">
                <div class="va-sidebar-head">
                    <button type="button" class="va-collapse-btn" data-va-collapse aria-label="@Loc(Ls["Sidebar.Collapse"], "Toggle sidebar")">
                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="3" y="3" width="18" height="18" rx="2"/><line x1="9" y1="3" x2="9" y2="21"/></svg>
                    </button>
                </div>
                <nav class="va-nav">
                    <a href="/visuauth/admin" class="@DashboardNavClass()">
                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="3" y="3" width="7" height="9" rx="1"/><rect x="14" y="3" width="7" height="5" rx="1"/><rect x="14" y="12" width="7" height="9" rx="1"/><rect x="3" y="16" width="7" height="5" rx="1"/></svg>
                        <span>@Ls["Sidebar.NavDashboard"]</span>
                    </a>
                    <a href="/visuauth/admin/users" class="@NavClass("/visuauth/admin/users")">
                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M16 21v-2a4 4 0 0 0-4-4H6a4 4 0 0 0-4 4v2"/><circle cx="9" cy="7" r="4"/><path d="M22 21v-2a4 4 0 0 0-3-3.87"/><path d="M16 3.13a4 4 0 0 1 0 7.75"/></svg>
                        <span>@Ls["Sidebar.NavUsers"]</span>
                    </a>
                    <a href="/visuauth/admin/roles" class="@NavClass("/visuauth/admin/roles")">
                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/></svg>
                        <span>@Ls["Sidebar.NavRoles"]</span>
                    </a>
                    @if (TenantContext.IsMultiTenancyEnabled)
                    {
                        <a href="/visuauth/admin/tenants" class="@NavClass("/visuauth/admin/tenants")">
                            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M3 21h18"/><path d="M5 21V7l8-4v18"/><path d="M19 21V11l-6-4"/><path d="M9 9v.01M9 12v.01M9 15v.01M9 18v.01"/></svg>
                            <span>@Ls["Sidebar.NavTenants"]</span>
                        </a>
                    }
                    else
                    {
                        <a href="#" aria-disabled="true" class="va-muted">
                            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M3 21h18"/><path d="M5 21V7l8-4v18"/><path d="M19 21V11l-6-4"/></svg>
                            <span>@Ls["Sidebar.NavTenantsSoon"]</span>
                        </a>
                    }
                    @if (externalProvidersAvailable)
                    {
                        <a href="/visuauth/admin/external-providers" class="@NavClass("/visuauth/admin/external-providers")">
                            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12 22v-5"/><path d="M9 8V2"/><path d="M15 8V2"/><path d="M18 8v5a4 4 0 0 1-4 4h-4a4 4 0 0 1-4-4V8z"/></svg>
                            <span>@Ls["Sidebar.NavExternalProviders"]</span>
                        </a>
                    }
                    @if (adapterConfigAvailable)
                    {
                        <a href="/visuauth/admin/entra-config" class="@NavClass("/visuauth/admin/entra-config")">
                            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12.22 2h-.44a2 2 0 0 0-2 2v.18a2 2 0 0 1-1 1.73l-.43.25a2 2 0 0 1-2 0l-.15-.08a2 2 0 0 0-2.73.73l-.22.38a2 2 0 0 0 .73 2.73l.15.1a2 2 0 0 1 1 1.72v.51a2 2 0 0 1-1 1.74l-.15.09a2 2 0 0 0-.73 2.73l.22.38a2 2 0 0 0 2.73.73l.15-.08a2 2 0 0 1 2 0l.43.25a2 2 0 0 1 1 1.73V20a2 2 0 0 0 2 2h.44a2 2 0 0 0 2-2v-.18a2 2 0 0 1 1-1.73l.43-.25a2 2 0 0 1 2 0l.15.08a2 2 0 0 0 2.73-.73l.22-.39a2 2 0 0 0-.73-2.73l-.15-.08a2 2 0 0 1-1-1.74v-.5a2 2 0 0 1 1-1.74l.15-.09a2 2 0 0 0 .73-2.73l-.22-.38a2 2 0 0 0-2.73-.73l-.15.08a2 2 0 0 1-2 0l-.43-.25a2 2 0 0 1-1-1.73V4a2 2 0 0 0-2-2z"/><circle cx="12" cy="12" r="3"/></svg>
                            <span>@Ls["Sidebar.NavAdapterConfig"]</span>
                        </a>
                    }
                    <a href="/visuauth/admin/audit-log" class="@NavClass("/visuauth/admin/audit-log")">
                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/><path d="M14 2v6h6"/><path d="M8 13h8"/><path d="M8 17h8"/><path d="M8 9h2"/></svg>
                        <span>@Ls["Sidebar.NavAuditLog"]</span>
                    </a>
                </nav>
            </aside>
            <main class="va-main">
                @RenderBody()
            </main>
        </div>
    </div>
</body>
</html>
