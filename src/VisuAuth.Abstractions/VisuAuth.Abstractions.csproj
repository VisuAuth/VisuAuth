<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>VisuAuth.Abstractions</RootNamespace>
    <AssemblyName>VisuAuth.Abstractions</AssemblyName>
    <!-- Ship XML docs with the package (IntelliSense for adapter / extension
         authors). With TreatWarningsAsErrors this also enforces a documented
         public surface (CS1591) — the contract is the product here. -->
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
  </PropertyGroup>

  <PropertyGroup Label="NuGet">
    <PackageId>VisuAuth.Abstractions</PackageId>
    <Title>VisuAuth Abstractions</Title>
    <Description>Public contracts and capability model for VisuAuth. Reference this package to write adapters or extensions that plug into VisuAuth (admin UI, auth flows, theming).</Description>
    <PackageTags>visuauth;aspnetcore;identity;abstractions;contracts</PackageTags>
    <PackageReadmeFile>README.md</PackageReadmeFile>
  </PropertyGroup>

  <ItemGroup>
    <!-- Package-specific README (contracts overview + the stability guarantee)
         instead of the generic repo README. -->
    <None Include="README.md" Pack="true" PackagePath="\" />
  </ItemGroup>

</Project>
