@using VisuAuth.Abstractions.Tenancy
@inject ITenantContext TenantContext
@model VisuAuth.AdminUi.Pages.Admin.Users.IndexModel
@{
    var result = Model.Result;
    var hasResults = result.Items.Count > 0;
    var showTenantColumn = TenantContext.IsMultiTenancyEnabled;

    // Build a query-string carrying the forward cursor plus every active
    // filter so the Next link preserves the user's narrowing instead of
    // resetting to the unfiltered first page.
    string NextLink(string cursor)
    {
        var qs = new List<string> { $"cursor={Uri.EscapeDataString(cursor)}" };
        if (!string.IsNullOrEmpty(Model.SearchTerm)) qs.Add($"q={Uri.EscapeDataString(Model.SearchTerm)}");
        if (!string.IsNullOrEmpty(Model.RoleFilter)) qs.Add($"role={Uri.EscapeDataString(Model.RoleFilter)}");
        if (!string.IsNullOrEmpty(Model.StatusFilter)) qs.Add($"status={Uri.EscapeDataString(Model.StatusFilter)}");
        if (!string.IsNullOrEmpty(Model.VerifiedFilter)) qs.Add($"verified={Uri.EscapeDataString(Model.VerifiedFilter)}");
        if (!string.IsNullOrEmpty(Model.TwoFactorFilter)) qs.Add($"twofa={Uri.EscapeDataString(Model.TwoFactorFilter)}");
        return $"/visuauth/admin/users?{string.Join("&", qs)}";
    }
}
<div id="va-users-table" class="va-card">
    @if (hasResults)
    {
        <table class="va-table">
            <thead>
            <tr>
                <th>@Ls["Users.Col.Email"]</th>
                <th>@Ls["Users.Col.Username"]</th>
                @if (showTenantColumn)
                {
                    <th>@Ls["Users.Col.Tenant"]</th>
                }
                <th>@Ls["Users.Col.Status"]</th>
                <th>@Ls["Users.Col.2fa"]</th>
                <th>@Ls["Users.Col.Verified"]</th>
            </tr>
            </thead>
            <tbody>
            @foreach (var user in result.Items)
            {
                <tr>
                    <td>
                        <a class="va-row-link" href="/visuauth/admin/users/@user.Id">@user.Email</a>
                    </td>
                    <td>@(user.UserName ?? Ls["Common.Dash"].Value)</td>
                    @if (showTenantColumn)
                    {
                        <td>
                            @if (!string.IsNullOrEmpty(user.TenantId))
                            {
                                <code class="va-tenant-id">@user.TenantId</code>
                            }
                            else
                            {
                                <span class="va-muted">@Ls["Common.Dash"]</span>
                            }
                        </td>
                    }
                    <td>
                        @if (user.IsEnabled)
                        {
                            <span class="va-pill va-pill-success">@Ls["Common.StatusActive"]</span>
                        }
                        else
                        {
                            <span class="va-pill va-pill-danger">@Ls["Common.StatusLocked"]</span>
                        }
                    </td>
                    <td>
                        <span class="va-badge">@(user.TwoFactorEnabled ? Ls["Common.On"].Value : Ls["Common.Off"].Value)</span>
                    </td>
                    <td>
                        <span class="va-badge @(user.EmailConfirmed ? "va-success" : "")">
                            @(user.EmailConfirmed ? Ls["Common.Yes"].Value : Ls["Common.Pending"].Value)
                        </span>
                    </td>
                </tr>
            }
            </tbody>
        </table>

        <div class="va-pagination">
            <div>
                @if (result.TotalCount is { } total)
                {
                    @Ls["Users.PaginationTotal", total]
                }
                else
                {
                    @Ls["Users.PaginationShowingCount", result.Items.Count]
                }
            </div>
            <div>
                @if (Model.HasPrevious)
                {
                    @* Forward-only cursor: "previous" steps back through the
                       browser history, where each Next push stored its cursor. *@
                    <button type="button" class="va-pagination-prev" onclick="history.back();return false;">@Ls["Common.Previous"]</button>
                }
                else
                {
                    <span class="va-disabled">@Ls["Common.Previous"]</span>
                }
                @if (result.HasMore)
                {
                    <a href="@NextLink(result.NextCursor!)"
                       hx-get="@NextLink(result.NextCursor!)"
                       hx-target="#va-users-table"
                       hx-swap="outerHTML"
                       hx-push-url="true">@Ls["Common.Next"]</a>
                }
                else
                {
                    <span class="va-disabled">@Ls["Common.Next"]</span>
                }
            </div>
        </div>
    }
    else
    {
        <div class="va-empty">
            @if (!string.IsNullOrWhiteSpace(Model.SearchTerm))
            {
                <p>@L["Users.EmptyNoMatch", Model.SearchTerm]</p>
            }
            else
            {
                <p>@Ls["Users.EmptyNone"]</p>
            }
        </div>
    }
</div>
