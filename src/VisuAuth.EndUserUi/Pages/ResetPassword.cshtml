@page "/visuauth/reset-password"
@model VisuAuth.EndUserUi.Pages.ResetPasswordModel
@{
    Layout = "_EndUserLayout";
    ViewData["Title"] = "Reset password — VisuAuth";
}

<h1 class="va-enduser-heading">Reset password</h1>
<p class="va-enduser-subtitle">Enter and confirm your new password.</p>

<va-form-errors errors="@Model.Errors" />

@if (Model.Succeeded)
{
    <div class="va-alert va-alert-success" role="status">
        <p><strong>Password updated.</strong> You can <a href="/visuauth/login">sign in</a> with your new password.</p>
    </div>
}
else if (!string.IsNullOrWhiteSpace(Model.Email) && !string.IsNullOrWhiteSpace(Model.Token))
{
    <form method="post" asp-page="/ResetPassword" class="va-enduser-form" autocomplete="on">
        @Html.AntiForgeryToken()
        <input type="hidden" name="email" value="@Model.Email" />
        <input type="hidden" name="token" value="@Model.Token" />

        <label class="va-field">
            <span class="va-field-label">Account</span>
            <input type="email" value="@Model.Email" class="va-input" disabled />
        </label>

        <va-password name="Form.NewPassword" label="New password" autocomplete="new-password" autofocus="true" />
        <va-password name="Form.ConfirmPassword" label="Confirm new password" autocomplete="new-password" />

        <button type="submit" class="va-btn va-btn-primary">Reset password</button>
    </form>
}

<div class="va-enduser-footer">
    <a href="/visuauth/login">Back to sign in</a>
</div>
