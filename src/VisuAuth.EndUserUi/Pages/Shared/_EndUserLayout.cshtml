@{
    var title = ViewData["Title"] as string ?? "VisuAuth";
    var brand = ViewData["Brand"] as string ?? "VisuAuth";
    var pageLang = System.Globalization.CultureInfo.CurrentUICulture.Name;
    var isAuthenticated = User?.Identity?.IsAuthenticated == true;
}<!doctype html>
<html lang="@pageLang">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>@title</title>
    @* Reuse the admin theme stylesheet — same design tokens (buttons, inputs,
       alerts) keep visual continuity between the public sign-in pages and the
       admin dashboard. *@
    <link rel="stylesheet" href="/_content/VisuAuth.AdminUi/visuauth.css" asp-append-version="true" />
    <link rel="stylesheet" href="/_content/VisuAuth.EndUserUi/visuauth-enduser.css" asp-append-version="true" />
    @* Programmatic theme overrides (CLAUDE.md §8.4 layer 2). Same tag
       helper as the admin layout — end-user pages stay visually aligned
       with the dashboard for free. *@
    <va-theme-style />
    @* htmx is served from VisuAuth.AdminUi's wwwroot — single source of
       truth across both surfaces, no outbound CDN call. *@
    <script src="/_content/VisuAuth.AdminUi/htmx.min.js" asp-append-version="true" defer></script>
    @* visuauth.js hosts client-side micro-interactions shared between admin
       and end-user pages (copy-to-clipboard, password show/hide). Same
       file as the admin layout — single source for both surfaces. *@
    <script src="/_content/VisuAuth.AdminUi/visuauth.js" asp-append-version="true" defer></script>
    @* Theme initializer — synchronous (NOT deferred) so the stored light/dark
       choice applies before the card paints (no flash). Served from
       VisuAuth.AdminUi's wwwroot (single source for both surfaces). *@
    <script src="/_content/VisuAuth.AdminUi/va-theme-init.js" asp-append-version="true"></script>
</head>
<body class="va-enduser-body">
    <main class="va-enduser-shell">
        <div class="va-enduser-card">
            <a class="va-brand va-enduser-brand" href="/">@brand</a>
            @if (isAuthenticated)
            {
                @* Authenticated quick-nav (CLAUDE.md §8 — drop-in surface; no
                   separate /account page). Setup 2FA + Sign out are the only
                   self-service entry points the end-user pages own today. *@
                <nav class="va-enduser-account" aria-label="@Ls["Layout.AccountNav"]">
                    <a href="/visuauth/two-factor/setup">@Ls["Layout.SetupTwoFactor"]</a>
                    <a href="/visuauth/logout">@Ls["Layout.SignOut"]</a>
                </nav>
            }
            @RenderBody()
            @* Language switcher (CLAUDE.md §10.1). Tucked under the card so
               the visitor can flip between en / pt-BR without leaving the
               sign-in flow. Auto-suppresses when a single culture is configured. *@
            <va-language-switcher class="va-enduser-lang" />
            @* Light/dark toggle under the language switcher — same behaviour as
               the admin sidebar (data attribute + persistence; icon swap is
               pure CSS). *@
            <button type="button" class="va-theme-toggle va-enduser-theme-toggle" data-va-theme-toggle aria-label="@Ls["Layout.ThemeToggle"]">
                <svg class="va-theme-toggle-icon va-icon-moon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79z"/></svg>
                <svg class="va-theme-toggle-icon va-icon-sun" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="12" cy="12" r="4"/><path d="M12 2v2M12 20v2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M2 12h2M20 12h2M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4"/></svg>
            </button>
        </div>
    </main>
</body>
</html>
