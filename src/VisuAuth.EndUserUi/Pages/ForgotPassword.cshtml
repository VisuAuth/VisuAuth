@page "/visuauth/forgot-password"
@model VisuAuth.EndUserUi.Pages.ForgotPasswordModel
@{
    Layout = "_EndUserLayout";
    ViewData["Title"] = Ls["Forgot.PageTitle"].Value;
}

<h1 class="va-enduser-heading">@Ls["Forgot.Heading"]</h1>
<p class="va-enduser-subtitle">@Ls["Forgot.Subtitle"]</p>

@if (ViewData.ModelState.ErrorCount > 0 && !Model.Submitted)
{
    <div class="va-alert va-alert-danger" role="alert">
        <ul>
            @foreach (var entry in ViewData.ModelState.Values.SelectMany(v => v.Errors))
            {
                <li>@entry.ErrorMessage</li>
            }
        </ul>
    </div>
}

@if (Model.Submitted)
{
    <div class="va-alert va-alert-success" role="status">
        <p>@Ls["Forgot.SubmittedNotice"]</p>
        @if (Model.ResetLink is { Length: > 0 } link)
        {
            <p>@Ls["Forgot.SubmittedDev"]</p>
            <p><a href="@link"><code>@link</code></a></p>
        }
    </div>
}
else if (Model.Capabilities.SupportsPasswordReset)
{
    <form method="post" asp-page="/ForgotPassword" class="va-enduser-form" autocomplete="on">
        @Html.AntiForgeryToken()

        <label class="va-field">
            <span class="va-field-label">@Ls["Common.LabelEmail"]</span>
            <input type="email"
                   name="Form.Email"
                   value="@Model.Form.Email"
                   class="va-input"
                   autocomplete="email"
                   required
                   autofocus />
        </label>

        <button type="submit" class="va-btn va-btn-primary">@Ls["Forgot.Submit"]</button>
    </form>
}
else
{
    <p class="va-enduser-subtitle">@Ls["Forgot.NotSupported"]</p>
}

<div class="va-enduser-footer">
    <a href="/visuauth/login">@Ls["Forgot.BackToSignIn"]</a>
</div>
