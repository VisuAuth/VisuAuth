@*
    Reusable widget that renders a one-time secret next to a copy-to-clipboard
    button. The button fires the global click handler in /visuauth.js — there
    is no per-page wiring.

    Model: the secret string to display and copy.
*@
@model string

<div class="va-copy-wrap">
    <code class="va-temp-password" data-va-copy-source>@Model</code>
    <button type="button"
            class="va-copy-btn"
            data-va-copy
            aria-label="@Ls["Common.CopyAria"]"
            title="@Ls["Common.CopyAria"]">
        <span class="va-copy-default">
            <svg class="va-copy-icon" xmlns="http://www.w3.org/2000/svg" width="14" height="14"
                 fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"
                 aria-hidden="true">
                <rect x="9" y="9" width="11" height="11" rx="2" />
                <path d="M5 15H4a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2h9a2 2 0 0 1 2 2v1" />
            </svg>
            <span>@Ls["Common.Copy"]</span>
        </span>
        <span class="va-copy-success" aria-hidden="true">
            <svg class="va-copy-icon" xmlns="http://www.w3.org/2000/svg" width="14" height="14"
                 fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="3">
                <polyline points="4 12 10 18 20 6" />
            </svg>
            <span>@Ls["Common.Copied"]</span>
        </span>
    </button>
</div>
