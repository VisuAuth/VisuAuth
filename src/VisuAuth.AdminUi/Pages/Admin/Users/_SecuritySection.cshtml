@model VisuAuth.AdminUi.Pages.Admin.Users.DetailModel
@{
    var detail = Model.Detail;
    var capabilities = Model.Capabilities;
    var detailUrl = $"/visuauth/admin/users/{detail.Id}";
    var isLockedOut = detail.LockoutEnd is { } end && end > DateTimeOffset.UtcNow;
}

<section class="va-card va-detail-card" id="va-user-security">
    <div class="va-detail-card-header">
        <h2>@Ls["Users.Security.Heading"]</h2>
    </div>

    <dl class="va-dl">
        <dt>@Ls["Users.Security.LockoutEnabled"]</dt>
        <dd>@(detail.LockoutEnabled ? Ls["Common.Yes"].Value : Ls["Common.No"].Value)</dd>

        <dt>@Ls["Users.Security.CurrentlyLocked"]</dt>
        <dd>
            @if (isLockedOut)
            {
                <span class="va-badge va-danger">@Ls["Users.Security.UntilFormat", detail.LockoutEnd!.Value.ToString("u")]</span>
            }
            else
            {
                <span class="va-muted">@Ls["Common.No"]</span>
            }
        </dd>

        <dt>@Ls["Users.Security.FailedAttempts"]</dt>
        <dd>@detail.AccessFailedCount</dd>

        <dt>@Ls["Users.Security.TwoFactor"]</dt>
        <dd>@(detail.TwoFactorEnabled ? Ls["Users.Security.TwoFactorEnabled"].Value : Ls["Users.Security.TwoFactorDisabled"].Value)</dd>
    </dl>

    <div class="va-actions">
        @if (capabilities.SupportsLockout)
        {
            if (isLockedOut)
            {
                <form method="post"
                      hx-post="@(detailUrl)?handler=Unlock"
                      hx-target="#va-user-detail-content"
                      hx-swap="innerHTML">
                    <button type="submit" class="va-btn va-btn-primary">@Ls["Users.Security.Unlock"]</button>
                </form>
            }
            else
            {
                <form method="post"
                      hx-post="@(detailUrl)?handler=Lock"
                      hx-target="#va-user-detail-content"
                      hx-swap="innerHTML"
                      hx-confirm="@Ls["Users.Security.LockConfirm"]">
                    <button type="submit" class="va-btn va-btn-warning">@Ls["Users.Security.Lock"]</button>
                </form>
            }
        }

        @if (capabilities.SupportsPasswordReset)
        {
            <form method="post"
                  hx-post="@(detailUrl)?handler=ResetPassword"
                  hx-target="#va-user-detail-content"
                  hx-swap="innerHTML"
                  hx-confirm="@Ls["Users.Security.ResetPasswordConfirm"]">
                <button type="submit" class="va-btn va-btn-ghost">@Ls["Users.Security.ResetPassword"]</button>
            </form>
        }

        @if (capabilities.SupportsTwoFactorReset)
        {
            <form method="post"
                  hx-post="@(detailUrl)?handler=ResetTwoFactor"
                  hx-target="#va-user-detail-content"
                  hx-swap="innerHTML"
                  hx-confirm="@Ls["Users.Security.Reset2faConfirm"]">
                <button type="submit" class="va-btn va-btn-ghost">@Ls["Users.Security.Reset2fa"]</button>
            </form>
        }

        @if (capabilities.SupportsSessionRevocation)
        {
            <form method="post"
                  hx-post="@(detailUrl)?handler=RevokeSessions"
                  hx-target="#va-user-detail-content"
                  hx-swap="innerHTML"
                  hx-confirm="@Ls["Users.Security.RevokeSessionsConfirm"]">
                <button type="submit" class="va-btn va-btn-ghost">@Ls["Users.Security.RevokeSessions"]</button>
            </form>
        }
    </div>
</section>
