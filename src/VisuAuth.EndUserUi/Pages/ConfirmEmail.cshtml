@page "/visuauth/confirm-email"
@model VisuAuth.EndUserUi.Pages.ConfirmEmailModel
@{
    Layout = "_EndUserLayout";
    ViewData["Title"] = Ls["Confirm.PageTitle"].Value;
}

<h1 class="va-enduser-heading">@Ls["Confirm.Heading"]</h1>

@if (Model.Succeeded)
{
    <div class="va-alert va-alert-success" role="status">
        <p><strong>@Ls["Confirm.Confirmed"]</strong> @L["Confirm.CanSignInNow"]</p>
    </div>
}
else if (Model.Errors.Count > 0)
{
    <div class="va-alert va-alert-danger" role="alert">
        <strong>@Ls["Confirm.NotConfirmed"]</strong>
        <ul>
            @foreach (var err in Model.Errors)
            {
                <li>@err</li>
            }
        </ul>
    </div>
}
else
{
    <p class="va-enduser-subtitle">@Ls["Confirm.Checking"]</p>
}

<div class="va-enduser-footer">
    <a href="/visuauth/login">@Ls["Forgot.BackToSignIn"]</a>
</div>
