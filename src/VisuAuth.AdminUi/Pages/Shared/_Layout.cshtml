@using VisuAuth.Abstractions.Authentication
@using VisuAuth.Abstractions.Tenancy
@inject ITenantContext TenantContext
@inject IServiceProvider Services
@{
    var title = ViewData["Title"] as string ?? Ls["Users.PageTitle"].Value;
    // Tenant catalogue is only registered when the consumer calls the generic
    // EnableVisuAuthTenancy overload, so reach for it via the service locator
    // rather than @inject so single-tenant deployments stay happy.
    var tenantStore = TenantContext.IsMultiTenancyEnabled
        ? Services.GetService(typeof(ITenantStore)) as ITenantStore
        : null;
    var sidebarTenants = tenantStore is null
        ? Array.Empty<TenantSummary>()
        : (IReadOnlyList<TenantSummary>)await tenantStore.ListAsync();
    var currentPath = Context.Request.Path + Context.Request.QueryString;
    var pageLang = System.Globalization.CultureInfo.CurrentUICulture.Name;
    // The External Providers admin page only works when the consumer wired
    // the runtime config store (AddVisuAuthExternalProviderConfigStore) —
    // typically the Identity adapter. Entra / Entra External deployments
    // don't register it (Microsoft owns the providers), so hide the link
    // there rather than send the operator to a "not available" card.
    // Service-locator lookup mirrors the ITenantStore pattern above.
    var externalProvidersAvailable =
        Services.GetService(typeof(IExternalProviderConfigStore)) is not null;
    // The adapter-config page only works when the consumer wired the DB store
    // (AddVisuAuthAdapterConfigStore) AND an adapter contributed a schema
    // (e.g. AddVisuAuthEntraDbConfig). Hide the link otherwise.
    var adapterConfigAvailable =
        Services.GetService(typeof(VisuAuth.Abstractions.Configuration.IAdapterConfigStore)) is not null
        && Services.GetService(typeof(IEnumerable<VisuAuth.Abstractions.Configuration.IAdapterConfigSchema>))
            is IEnumerable<VisuAuth.Abstractions.Configuration.IAdapterConfigSchema> schemas
        && schemas.Any();
}<!doctype html>
<html lang="@pageLang">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>@title</title>
    @* asp-append-version pins ?v={file-hash}, so a stylesheet rebuild forces
       browsers to fetch the new content instead of serving a stale cached copy. *@
    <link rel="stylesheet" href="/_content/VisuAuth.AdminUi/visuauth.css" asp-append-version="true" />
    @* Programmatic theme overrides (CLAUDE.md §8.4 layer 2). Tag helper
       suppresses itself when no VisuAuthTheme properties were configured,
       so the markup stays clean for the default-theme case. Placed AFTER
       the stylesheet link so overrides win on source order. *@
    <va-theme-style />
    @* htmx is shipped as an embedded static asset so air-gapped
       deployments work out of the box (no outbound CDN call). The file
       at wwwroot/htmx.min.js is htmx 2.0.4 verbatim — keep it in sync
       when bumping the version. *@
    <script src="/_content/VisuAuth.AdminUi/htmx.min.js" asp-append-version="true" defer></script>
    <script src="/_content/VisuAuth.AdminUi/visuauth.js" asp-append-version="true" defer></script>
    @* Theme initializer — synchronous (NOT deferred) so the stored light/dark
       choice applies during head parse, before the page paints (no flash).
       Also wires the toggle button below. Must stay non-deferred. *@
    <script src="/_content/VisuAuth.AdminUi/va-theme-init.js" asp-append-version="true"></script>
</head>
<body>
    @{
        // Highlight the sidebar entry that matches the current URL. Razor
        // partials inherit the host request, so Request.Path is the live URL.
        var path = Context.Request.Path.Value ?? string.Empty;
        string NavClass(string segment) =>
            path.StartsWith(segment, StringComparison.OrdinalIgnoreCase) ? "va-active" : "";
        // Dashboard sits at the admin root, so the StartsWith helper
        // above would mark it active on every /admin/* path. Match
        // exactly instead — trailing slash optional.
        string DashboardNavClass() =>
            string.Equals(path, "/visuauth/admin", StringComparison.OrdinalIgnoreCase)
            || string.Equals(path, "/visuauth/admin/", StringComparison.OrdinalIgnoreCase)
                ? "va-active" : "";
    }
    <div class="va-app">
        @* Top bar — brand (left) · light/dark toggle (right). Mirrors the
           Linear/Vercel-style chrome the design system specifies. *@
        <header class="va-header">
            <div class="va-header-group">
                <a class="va-brand" href="/visuauth/admin">
                    @* Brand mark — indigo rounded square (gradient comes from
                       --visuauth-primary, so it re-themes with the consumer's
                       palette) carrying the white VisuAuth "V" glyph. *@
                    <span class="va-brand-mark" aria-hidden="true">
                        <svg viewBox="0 0 40 40" width="18" height="18" fill="none" aria-hidden="true">
                            <path d="M11 12.5 L20 27.5 L29 12.5" stroke="currentColor" stroke-width="3.4" stroke-linecap="round" stroke-linejoin="round" />
                            <circle cx="20" cy="14.2" r="2.4" fill="currentColor" />
                        </svg>
                    </span>
                    <span>VisuAuth</span>
                </a>
            </div>
            <div class="va-header-group">
                @* Light/dark toggle (icon-only in the header). va-theme-init.js
                   flips + persists the choice via the data attribute; the icon
                   swap is pure CSS (data-theme). Both icons ship in the markup. *@
                <button type="button" class="va-theme-toggle va-header-theme" data-va-theme-toggle aria-label="@Ls["Sidebar.ThemeToggle"]">
                    <svg class="va-theme-toggle-icon va-icon-moon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79z"/></svg>
                    <svg class="va-theme-toggle-icon va-icon-sun" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="12" cy="12" r="4"/><path d="M12 2v2M12 20v2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M2 12h2M20 12h2M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4"/></svg>
                </button>
            </div>
        </header>
        <div class="va-shell">
            <aside class="va-sidebar">
                <nav class="va-nav">
                <a href="/visuauth/admin" class="@DashboardNavClass()">@Ls["Sidebar.NavDashboard"]</a>
                <a href="/visuauth/admin/users" class="@NavClass("/visuauth/admin/users")">@Ls["Sidebar.NavUsers"]</a>
                <a href="/visuauth/admin/roles" class="@NavClass("/visuauth/admin/roles")">@Ls["Sidebar.NavRoles"]</a>
                @if (TenantContext.IsMultiTenancyEnabled)
                {
                    <a href="/visuauth/admin/tenants" class="@NavClass("/visuauth/admin/tenants")">@Ls["Sidebar.NavTenants"]</a>
                }
                else
                {
                    <a href="#" aria-disabled="true" class="va-muted">@Ls["Sidebar.NavTenantsSoon"]</a>
                }
                @if (externalProvidersAvailable)
                {
                    <a href="/visuauth/admin/external-providers" class="@NavClass("/visuauth/admin/external-providers")">@Ls["Sidebar.NavExternalProviders"]</a>
                }
                @if (adapterConfigAvailable)
                {
                    <a href="/visuauth/admin/entra-config" class="@NavClass("/visuauth/admin/entra-config")">@Ls["Sidebar.NavAdapterConfig"]</a>
                }
                <a href="/visuauth/admin/audit-log" class="@NavClass("/visuauth/admin/audit-log")">@Ls["Sidebar.NavAuditLog"]</a>
            </nav>
            @if (TenantContext.IsMultiTenancyEnabled)
            {
                @* Tenant switcher sits below the nav (and above the language
                   switcher) so operators reach for it less often — it's a
                   contextual control, not a destination. asp-page +
                   asp-page-handler engage the form tag helper so the
                   antiforgery token is auto-injected. The explicit
                   @Html.AntiForgeryToken() is belt-and-suspenders for any case
                   where the helper does not run (rare, but cheap insurance —
                   the sidebar renders on every admin page, so missing tokens
                   here would brick the switcher for browser users). *@
                <form method="post"
                      asp-page="/Admin/Tenants/Index"
                      asp-page-handler="Switch"
                      class="va-tenant-indicator">
                    @Html.AntiForgeryToken()
                    <span class="va-field-label">@Ls["Sidebar.TenantScope"]</span>
                    <input type="hidden" name="returnUrl" value="@currentPath" />
                    <select name="tenantId"
                            class="va-input va-tenant-switcher"
                            onchange="this.form.submit();">
                        <option value="" selected="@(string.IsNullOrEmpty(TenantContext.CurrentTenantId) ? "selected" : null)">@Ls["Sidebar.TenantGlobal"]</option>
                        @foreach (var tenant in sidebarTenants)
                        {
                            <option value="@tenant.Id" selected="@(string.Equals(tenant.Id, TenantContext.CurrentTenantId, StringComparison.Ordinal) ? "selected" : null)">
                                @tenant.DisplayName
                            </option>
                        }
                    </select>
                    <noscript>
                        <button type="submit" class="va-btn va-btn-small va-btn-ghost">@Ls["Sidebar.TenantApply"]</button>
                    </noscript>
                </form>
            }
            @* Language switcher (CLAUDE.md §10.1). The tag helper suppresses
               itself when only one culture is configured, so the markup
               stays clean for single-language deployments. *@
            <va-language-switcher class="va-tenant-indicator" />
        </aside>
        <main class="va-main">
            @RenderBody()
        </main>
        </div>
    </div>
</body>
</html>
