<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>VisuAuth.Entra</RootNamespace>
    <AssemblyName>VisuAuth.Entra</AssemblyName>
  </PropertyGroup>

  <PropertyGroup Label="NuGet">
    <PackageId>VisuAuth.Entra</PackageId>
    <Title>VisuAuth Microsoft Entra ID Adapter</Title>
    <Description>Microsoft Entra ID (workforce) adapter for VisuAuth: implements IUserStore, IRoleStore, and IAuthenticationFlow against the Microsoft Graph API using app-only (client credentials) auth. Declares SupportsLocalLogin = false so the end-user UI swaps the password form for a "Sign in with Microsoft" button automatically.</Description>
    <PackageTags>visuauth;entra;azuread;graph;adapter;identity</PackageTags>
    <PackageReadmeFile>README.md</PackageReadmeFile>
  </PropertyGroup>

  <ItemGroup>
    <!-- Adapter-specific README so nuget.org's package page shows
         Entra setup / capabilities / troubleshooting directly, instead
         of the generic project overview. -->
    <None Include="README.md" Pack="true" PackagePath="\" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\VisuAuth.Abstractions\VisuAuth.Abstractions.csproj" />
    <!-- EntraCore hosts the no-op stubs (IAuditWriter / IJwtIssuer / etc.),
         the GraphServiceClient factory, and the temporary-password
         generator that every Entra-family adapter shares. We deliberately
         do NOT reference VisuAuth.Identity here — adapters stay
         independent of each other per CLAUDE.md §2.5. -->
    <ProjectReference Include="..\VisuAuth.EntraCore\VisuAuth.EntraCore.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- Microsoft.Graph + Azure.Identity flow in transitively via EntraCore;
         the explicit references here are belt-and-suspenders for code in
         THIS package that calls them directly (Graph types in EntraUserStore /
         EntraRoleStore). -->
    <PackageReference Include="Microsoft.Graph" />
    <PackageReference Include="Azure.Identity" />
    <PackageReference Include="Microsoft.Extensions.Options.ConfigurationExtensions" />
    <PackageReference Include="Microsoft.Extensions.Options.DataAnnotations" />
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" />
  </ItemGroup>

  <ItemGroup Label="Test access">
    <InternalsVisibleTo Include="VisuAuth.UnitTests" />
  </ItemGroup>

</Project>
