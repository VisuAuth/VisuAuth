@page "/visuauth/confirm-email"
@model VisuAuth.EndUserUi.Pages.ConfirmEmailModel
@{
    Layout = "_EndUserLayout";
    ViewData["Title"] = "Confirm email — VisuAuth";
}

<h1 class="va-enduser-heading">Confirm email</h1>

@if (Model.Succeeded)
{
    <div class="va-alert va-alert-success" role="status">
        <p><strong>Email confirmed.</strong> You can <a href="/visuauth/login">sign in</a> now.</p>
    </div>
}
else if (Model.Errors.Count > 0)
{
    <div class="va-alert va-alert-danger" role="alert">
        <strong>We could not confirm your email.</strong>
        <ul>
            @foreach (var err in Model.Errors)
            {
                <li>@err</li>
            }
        </ul>
    </div>
}
else
{
    <p class="va-enduser-subtitle">Checking your confirmation link…</p>
}

<div class="va-enduser-footer">
    <a href="/visuauth/login">Back to sign in</a>
</div>
