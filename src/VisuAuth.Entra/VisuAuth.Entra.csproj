<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>VisuAuth.Entra</RootNamespace>
    <AssemblyName>VisuAuth.Entra</AssemblyName>
  </PropertyGroup>

  <PropertyGroup Label="NuGet">
    <PackageId>VisuAuth.Entra</PackageId>
    <Title>VisuAuth Microsoft Entra ID Adapter</Title>
    <Description>Microsoft Entra ID (workforce) adapter for VisuAuth: implements IUserStore, IRoleStore, and IAuthenticationFlow against the Microsoft Graph API using app-only (client credentials) auth. Declares SupportsLocalLogin = false so the end-user UI swaps the password form for a "Sign in with Microsoft" button automatically.</Description>
    <PackageTags>visuauth;entra;azuread;graph;adapter;identity</PackageTags>
    <PackageReadmeFile>README.md</PackageReadmeFile>
  </PropertyGroup>

  <ItemGroup>
    <None Include="..\..\README.md" Pack="true" PackagePath="\" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\VisuAuth.Abstractions\VisuAuth.Abstractions.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- Microsoft.Graph is the Kiota-generated SDK for the Graph REST API.
         Azure.Identity supplies ClientSecretCredential / DefaultAzureCredential
         for the app-only flow. We deliberately do NOT reference VisuAuth.Identity
         or any ASP.NET Core Identity package here — Entra adapter must stay
         independent of the Identity adapter per CLAUDE.md §2.5 / §6. -->
    <PackageReference Include="Microsoft.Graph" />
    <PackageReference Include="Azure.Identity" />
    <PackageReference Include="Microsoft.Extensions.Options.ConfigurationExtensions" />
    <PackageReference Include="Microsoft.Extensions.Options.DataAnnotations" />
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" />
  </ItemGroup>

  <ItemGroup Label="Test access">
    <InternalsVisibleTo Include="VisuAuth.UnitTests" />
  </ItemGroup>

</Project>
