@model VisuAuth.AdminUi.Pages.Admin.Roles.IndexModel

@if (Model.ActionErrors.Count > 0)
{
    <div class="va-alert va-alert-danger" role="alert">
        <strong>@Ls["Roles.ActionFailed"]</strong>
        <ul>
            @foreach (var err in Model.ActionErrors)
            {
                <li>@err</li>
            }
        </ul>
    </div>
}
else if (Model.ActionMessage is { Length: > 0 } msg)
{
    <div class="va-alert va-alert-success" role="status">@msg</div>
}

@if (Model.Capabilities.SupportsRoleMutation)
{
    <section class="va-card va-detail-card">
        <div class="va-detail-card-header">
            <h2>@Ls["Roles.CreateHeading"]</h2>
        </div>
        <form method="post"
              hx-post="/visuauth/admin/roles?handler=Create"
              hx-target="#va-roles-catalogue"
              hx-swap="innerHTML"
              class="va-inline-form">
            <label class="va-field va-inline-field">
                <span class="va-field-label">@Ls["Common.LabelName"]</span>
                <input type="text"
                       name="NewRoleName"
                       value="@Model.NewRoleName"
                       placeholder="@Ls["Roles.NamePlaceholder"]"
                       class="va-input"
                       required />
            </label>
            <button type="submit" class="va-btn va-btn-primary">@Ls["Roles.AddButton"]</button>
        </form>
    </section>
}
else
{
    @* Backends like Microsoft Entra declare roles externally (app
       registration manifest), so create / rename / delete aren't
       available here — only list + assign. Show an explanatory card
       instead of a form that would fail on submit. *@
    <section class="va-card va-detail-card">
        <div class="va-detail-card-header">
            <h2>@Ls["Roles.MutationNotSupported.Heading"]</h2>
        </div>
        <p class="va-muted">@L["Roles.MutationNotSupported.Body"]</p>
    </section>
}

<section class="va-card">
    @if (Model.Roles.Count == 0)
    {
        <div class="va-empty">
            <p>@(Model.Capabilities.SupportsRoleMutation ? Ls["Roles.Empty"] : Ls["Roles.EmptyReadOnly"])</p>
        </div>
    }
    else
    {
        <table class="va-table">
            <thead>
            <tr>
                <th>@Ls["Common.LabelName"]</th>
                <th>@Ls["Roles.Col.Members"]</th>
                @if (Model.Capabilities.SupportsRoleMutation)
                {
                    <th class="va-col-actions">@Ls["Common.Actions"]</th>
                }
            </tr>
            </thead>
            <tbody>
            @foreach (var role in Model.Roles)
            {
                var inEditMode = string.Equals(Model.EditingRoleId, role.Id, StringComparison.Ordinal);
                <tr>
                    @if (inEditMode)
                    {
                        <td colspan="3">
                            <form method="post"
                                  hx-post="/visuauth/admin/roles?handler=Rename"
                                  hx-target="#va-roles-catalogue"
                                  hx-swap="innerHTML"
                                  class="va-inline-form">
                                <input type="hidden" name="id" value="@role.Id" />
                                <label class="va-field va-inline-field">
                                    <span class="va-field-label">@Ls["Roles.RenameLabel", role.Name]</span>
                                    <input type="text"
                                           name="RenamedRoleName"
                                           value="@(Model.RenamedRoleName ?? role.Name)"
                                           class="va-input"
                                           required
                                           autofocus />
                                </label>
                                <button type="submit" class="va-btn va-btn-primary va-btn-small">@Ls["Common.Save"]</button>
                                <button type="button"
                                        class="va-btn va-btn-ghost va-btn-small"
                                        hx-get="/visuauth/admin/roles"
                                        hx-target="#va-roles-catalogue"
                                        hx-swap="innerHTML">@Ls["Common.Cancel"]</button>
                            </form>
                        </td>
                    }
                    else
                    {
                        <td><strong>@role.Name</strong></td>
                        <td><span class="va-badge">@role.MemberCount</span></td>
                        @if (Model.Capabilities.SupportsRoleMutation)
                        {
                            <td class="va-col-actions">
                                <div class="va-row-actions">
                                    <button type="button"
                                            class="va-btn va-btn-ghost va-btn-small"
                                            hx-get="/visuauth/admin/roles?handler=EditRole&amp;id=@role.Id"
                                            hx-target="#va-roles-catalogue"
                                            hx-swap="innerHTML"
                                            aria-label="@Ls["Roles.RenameAria", role.Name]">@Ls["Common.Rename"]</button>
                                    <form method="post"
                                          hx-post="/visuauth/admin/roles?handler=Delete"
                                          hx-target="#va-roles-catalogue"
                                          hx-swap="innerHTML"
                                          hx-confirm="@Ls["Roles.DeleteConfirm", role.Name]">
                                        <input type="hidden" name="id" value="@role.Id" />
                                        <button type="submit"
                                                class="va-btn va-btn-danger va-btn-small"
                                                aria-label="@Ls["Roles.DeleteAria", role.Name]">@Ls["Common.Delete"]</button>
                                    </form>
                                </div>
                            </td>
                        }
                    }
                </tr>
            }
            </tbody>
        </table>
    }
</section>
