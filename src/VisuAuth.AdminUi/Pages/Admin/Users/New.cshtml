@page "/visuauth/admin/users/new"
@model VisuAuth.AdminUi.Pages.Admin.Users.NewModel
@{
    ViewData["Title"] = Ls["Users.New.PageTitle"].Value;
}

<div class="va-page-header">
    <div>
        <a class="va-back" href="/visuauth/admin/users">@Ls["Users.Detail.Back"]</a>
        <h1>@Ls["Users.New.Heading"]</h1>
        <div class="va-muted va-detail-subtitle">
            @Ls["Users.New.Subtitle"]
        </div>
    </div>
</div>

<va-form-errors errors="@Model.Errors" lead="@Ls["Users.New.ErrorLead"].Value" />

@if (Model.CreatedUserId is { Length: > 0 } createdId)
{
    <div class="va-alert va-alert-success" role="status">
        <p>
            @Ls["Users.New.Created"]
            <a href="/visuauth/admin/users/@createdId">@Ls["Users.New.OpenDetail"]</a>
        </p>
    </div>

    if (Model.GeneratedPassword is { Length: > 0 } temp)
    {
        <div class="va-alert va-alert-info" role="status">
            <p>
                <strong>@Ls["Users.Detail.TempPasswordHeading"]</strong> @Ls["Users.New.TempPasswordDesc"]
            </p>
            <partial name="_CopyableSecret" model="@temp" />
        </div>
    }
}

<section class="va-card va-detail-card">
    <div class="va-detail-card-header">
        <h2>@Ls["Users.Profile.Heading"]</h2>
    </div>

    <form method="post" autocomplete="off">
        <div class="va-form-grid">
            @if (Model.EmailDomainChoices.Count >= 2)
            {
                @* Tenant exposes several verified domains (multi-domain Entra
                   directory). Offer a local-part input plus a domain dropdown
                   so the operator picks which verified domain the new mailbox
                   lives under. type="text" because the local part has no "@".
                   The pagemodel joins local-part + "@" + selected domain after
                   validating the choice against EmailDomainChoices. *@
                @* A <div> (not a wrapping <label>) so the <select> isn't
                   nested inside a label element — that keeps each control's
                   accessible name unambiguous (the local part gets an explicit
                   <label for>, the domain select gets its own aria-label, same
                   as the standalone filter selects on the Users list). *@
                <div class="va-field">
                    <label class="va-field-label" for="va-newuser-email-local">@Ls["Common.LabelEmail"] <span class="va-required">*</span></label>
                    <div class="va-input-group">
                        <input id="va-newuser-email-local"
                               type="text"
                               name="Form.Email"
                               value="@Model.Form.Email"
                               required
                               autocomplete="off"
                               spellcheck="false"
                               pattern="[A-Za-z0-9._%+\-]+"
                               title="@Ls["Users.New.EmailLocalPartHint"]"
                               class="va-input va-input-group-input" />
                        <span class="va-input-group-at" aria-hidden="true">@@</span>
                        @* A real (visually-hidden) <label for> gives the select
                           its accessible name without an aria-label override,
                           which keeps the WCAG "label in name" check happy. *@
                        <label for="va-newuser-email-domain" class="va-sr-only">@Ls["Users.New.EmailDomainSelectAria"]</label>
                        <select id="va-newuser-email-domain"
                                name="Form.EmailDomain"
                                class="va-input va-input-group-select">
                            @foreach (var domain in Model.EmailDomainChoices)
                            {
                                if (string.Equals(domain, Model.Form.EmailDomain, StringComparison.OrdinalIgnoreCase))
                                {
                                    <option value="@domain" selected>@domain</option>
                                }
                                else
                                {
                                    <option value="@domain">@domain</option>
                                }
                            }
                        </select>
                    </div>
                    <span class="va-field-hint va-muted">@Ls["Users.New.EmailDomainSelectHint"]</span>
                </div>
            }
            else if (Model.Capabilities.EmailDomainSuffix is { Length: > 0 } emailSuffix)
            {
                @* Backend reports a fixed verified domain (e.g. Entra ID
                   workforce). Lock the suffix visually and only let the
                   operator type the local part. type="text" because the
                   <input type="email"> validator demands "@" which the
                   user no longer types. The pagemodel re-appends the
                   suffix server-side before calling the store. *@
                <label class="va-field">
                    <span class="va-field-label">@Ls["Common.LabelEmail"] <span class="va-required">*</span></span>
                    <div class="va-input-group">
                        <input type="text"
                               name="Form.Email"
                               value="@Model.Form.Email"
                               required
                               autocomplete="off"
                               spellcheck="false"
                               pattern="[A-Za-z0-9._%+\-]+"
                               title="@Ls["Users.New.EmailLocalPartHint"]"
                               aria-label="@Ls["Users.New.EmailLocalPartAria"]"
                               class="va-input va-input-group-input" />
                        <span class="va-input-group-suffix"
                              aria-label="@Ls["Users.New.EmailDomainAria"]"
                              title="@Ls["Users.New.EmailDomainLockedHint"]">@emailSuffix</span>
                    </div>
                    <span class="va-field-hint va-muted">@Ls["Users.New.EmailDomainLockedHint"]</span>
                </label>
            }
            else
            {
                <label class="va-field">
                    <span class="va-field-label">@Ls["Common.LabelEmail"] <span class="va-required">*</span></span>
                    <input type="email"
                           name="Form.Email"
                           value="@Model.Form.Email"
                           required
                           class="va-input" />
                </label>
            }

            <label class="va-field">
                <span class="va-field-label">@Ls["Common.LabelUsername"]</span>
                <input type="text"
                       name="Form.UserName"
                       value="@Model.Form.UserName"
                       placeholder="@Ls["Users.New.UsernamePlaceholder"]"
                       class="va-input" />
            </label>

            <va-password name="Form.Password"
                         placeholder="@Ls["Users.New.PasswordPlaceholder"].Value"
                         autocomplete="new-password"
                         required="false" />

            <label class="va-field">
                <span class="va-field-label">@Ls["Common.LabelPhone"]</span>
                <input type="tel"
                       name="Form.PhoneNumber"
                       value="@Model.Form.PhoneNumber"
                       class="va-input" />
            </label>
        </div>

        <label class="va-checkbox">
            @{
                var emailConfirmedChecked = Model.Form.EmailConfirmed ? "checked" : null;
            }
            <input type="checkbox"
                   name="Form.EmailConfirmed"
                   value="true"
                   checked="@emailConfirmedChecked" />
            <span>@Ls["Users.New.EmailConfirmedLabel"]</span>
        </label>

        @if (Model.Capabilities.SupportsRoleManagement && Model.AvailableRoles.Count > 0)
        {
            <fieldset class="va-fieldset">
                <legend class="va-field-label">@Ls["Users.New.RolesHeading"]</legend>
                <p class="va-muted va-empty-inline">@Ls["Users.New.RolesHint"]</p>
                <div class="va-checkbox-grid">
                    @foreach (var role in Model.AvailableRoles)
                    {
                        var isChecked = Model.Form.SelectedRoles.Contains(role.Name, StringComparer.OrdinalIgnoreCase) ? "checked" : null;
                        <label class="va-checkbox">
                            <input type="checkbox"
                                   name="Form.SelectedRoles"
                                   value="@role.Name"
                                   checked="@isChecked" />
                            <span>@role.Name</span>
                        </label>
                    }
                </div>
            </fieldset>
        }

        <div class="va-form-actions">
            <button type="submit" class="va-btn va-btn-primary">@Ls["Users.New.Submit"]</button>
            <a class="va-btn va-btn-ghost" href="/visuauth/admin/users">@Ls["Common.Cancel"]</a>
        </div>
    </form>
</section>
