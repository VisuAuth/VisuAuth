<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>Sample.EntraWebApp</RootNamespace>
    <AssemblyName>Sample.EntraWebApp</AssemblyName>
    <!-- Same UserSecretsId as Sample.WebApp on purpose: a developer who
         already populated VisuAuth:Entra:TenantId / ClientId / ClientSecret
         for the bigger sample gets to run this minimal one without
         re-setting the same three secrets. They're per-machine
         (%APPDATA%\Microsoft\UserSecrets\), never committed. -->
    <UserSecretsId>visuauth-sample-webapp</UserSecretsId>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <!-- The meta-package and the Entra adapter — that's it. No
         Microsoft.AspNetCore.Identity.*, no EF Core, no OAuth providers,
         no JWT issuer. The whole point of this sample is to show the
         shortest possible path from "fresh ASP.NET Core project" to
         "admin UI against a real Microsoft Entra ID tenant". -->
    <ProjectReference Include="..\..\src\VisuAuth\VisuAuth.csproj" />
    <ProjectReference Include="..\..\src\VisuAuth.Entra\VisuAuth.Entra.csproj" />
  </ItemGroup>

</Project>
