@*
    Cascades the same imports VisuAuth's package _ViewImports declares,
    so overrides under /Views/VisuAuth/ compile against the same
    namespaces and localizers as the originals (L / Ls helpers, tag
    helpers, etc.). Without this, Razor parses each override as a
    raw .cshtml with no shared aliases.
*@
@addTagHelper *, Microsoft.AspNetCore.Mvc.TagHelpers
@addTagHelper *, VisuAuth.AdminUi
@addTagHelper *, VisuAuth.EndUserUi
@using Microsoft.AspNetCore.Mvc.Localization
@using Microsoft.Extensions.Localization
@using VisuAuth.AdminUi
@using VisuAuth.AdminUi.Localization
@using VisuAuth.EndUserUi
@inject IHtmlLocalizer<AdminSharedResources> L
@inject IStringLocalizer<AdminSharedResources> Ls
