@model VisuAuth.AdminUi.Pages.Admin.Users.DetailModel
@{
    var detail = Model.Detail;
    var detailUrl = $"/visuauth/admin/users/{detail.Id}";
}

<section class="va-card va-detail-card" id="va-user-profile">
    @if (Model.ProfileEditMode)
    {
        <form method="post"
              hx-post="@(detailUrl)?handler=UpdateProfile"
              hx-target="#va-user-detail-content"
              hx-swap="innerHTML">
            <div class="va-detail-card-header">
                <h2>Edit profile</h2>
            </div>

            <div class="va-form-grid">
                <label class="va-field">
                    <span class="va-field-label">Email</span>
                    <input type="email"
                           name="Profile.Email"
                           value="@Model.Profile.Email"
                           required
                           class="va-input" />
                </label>

                <label class="va-field">
                    <span class="va-field-label">Username</span>
                    <input type="text"
                           name="Profile.UserName"
                           value="@Model.Profile.UserName"
                           class="va-input" />
                </label>

                <label class="va-field">
                    <span class="va-field-label">Phone</span>
                    <input type="tel"
                           name="Profile.PhoneNumber"
                           value="@Model.Profile.PhoneNumber"
                           class="va-input" />
                </label>
            </div>

            <div class="va-form-actions">
                <button type="submit" class="va-btn va-btn-primary">Save profile</button>
                <button type="button"
                        class="va-btn va-btn-ghost"
                        hx-get="@(detailUrl)?handler=ViewProfile"
                        hx-target="#va-user-profile"
                        hx-swap="outerHTML">Cancel</button>
            </div>
        </form>
    }
    else
    {
        <div class="va-detail-card-header">
            <h2>Profile</h2>
            <button type="button"
                    class="va-btn va-btn-ghost va-btn-small"
                    hx-get="@(detailUrl)?handler=EditProfile"
                    hx-target="#va-user-profile"
                    hx-swap="outerHTML">Edit</button>
        </div>

        <dl class="va-dl">
            <dt>Email</dt>
            <dd>@detail.Email</dd>

            <dt>Username</dt>
            <dd>@(detail.UserName ?? "—")</dd>

            <dt>Phone</dt>
            <dd>
                @(string.IsNullOrEmpty(detail.PhoneNumber) ? "—" : detail.PhoneNumber)
                @if (!string.IsNullOrEmpty(detail.PhoneNumber))
                {
                    <span class="va-badge @(detail.PhoneNumberConfirmed ? "va-success" : "")">
                        @(detail.PhoneNumberConfirmed ? "Verified" : "Pending")
                    </span>
                }
            </dd>

            @if (!string.IsNullOrEmpty(detail.TenantId))
            {
                <dt>Tenant</dt>
                <dd><code>@detail.TenantId</code></dd>
            }

            @if (detail.CreatedAt != default)
            {
                <dt>Created</dt>
                <dd>@detail.CreatedAt.ToString("u")</dd>
            }

            @if (detail.LastSignInAt is { } lastSignIn)
            {
                <dt>Last sign-in</dt>
                <dd>@lastSignIn.ToString("u")</dd>
            }
        </dl>
    }
</section>
