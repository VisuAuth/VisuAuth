<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>Sample.WebApp</RootNamespace>
    <AssemblyName>Sample.WebApp</AssemblyName>
    <UserSecretsId>visuauth-sample-webapp</UserSecretsId>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\VisuAuth\VisuAuth.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.Identity.EntityFrameworkCore" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Sqlite" />
    <!-- Sample-only: powers each external-login button when the developer
         fills in ClientId/ClientSecret in ExternalProviders.*. The VisuAuth
         packages themselves ship no provider deps — consumers add the ones
         they actually wire. -->
    <PackageReference Include="Microsoft.AspNetCore.Authentication.MicrosoftAccount" />
    <PackageReference Include="Microsoft.AspNetCore.Authentication.Google" />
    <PackageReference Include="AspNet.Security.OAuth.Apple" />
    <PackageReference Include="AspNet.Security.OAuth.GitHub" />
  </ItemGroup>

</Project>
