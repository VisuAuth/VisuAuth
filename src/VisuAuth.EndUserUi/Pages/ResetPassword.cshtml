@page "/visuauth/reset-password"
@model VisuAuth.EndUserUi.Pages.ResetPasswordModel
@{
    Layout = "_EndUserLayout";
    ViewData["Title"] = Ls["Reset.PageTitle"].Value;
}

<h1 class="va-enduser-heading">@Ls["Reset.Heading"]</h1>
<p class="va-enduser-subtitle">@Ls["Reset.Subtitle"]</p>

<va-form-errors errors="@Model.Errors" />

@if (Model.Succeeded)
{
    <div class="va-alert va-alert-success" role="status">
        <p><strong>@Ls["Reset.PasswordUpdated"]</strong> @L["Reset.CanSignInNew"]</p>
    </div>
}
else if (!string.IsNullOrWhiteSpace(Model.Email) && !string.IsNullOrWhiteSpace(Model.Token))
{
    <form method="post" asp-page="/ResetPassword" class="va-enduser-form" autocomplete="on">
        @Html.AntiForgeryToken()
        <input type="hidden" name="email" value="@Model.Email" />
        <input type="hidden" name="token" value="@Model.Token" />

        <label class="va-field">
            <span class="va-field-label">@Ls["Reset.AccountLabel"]</span>
            <input type="email" value="@Model.Email" class="va-input" disabled />
        </label>

        <va-password name="Form.NewPassword" label="@Ls["Reset.NewPasswordLabel"].Value" autocomplete="new-password" autofocus="true" />
        <va-password name="Form.ConfirmPassword" label="@Ls["Reset.ConfirmPasswordLabel"].Value" autocomplete="new-password" />

        <button type="submit" class="va-btn va-btn-primary">@Ls["Reset.Submit"]</button>
    </form>
}

<div class="va-enduser-footer">
    <a href="/visuauth/login">@Ls["Forgot.BackToSignIn"]</a>
</div>
