<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>Sample.WebApp</RootNamespace>
    <AssemblyName>Sample.WebApp</AssemblyName>
    <UserSecretsId>visuauth-sample-webapp</UserSecretsId>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\VisuAuth\VisuAuth.csproj" />
    <!-- Entra adapter referenced directly so the sample can flip backends
         via the VISUAUTH_BACKEND env var. The meta-package doesn't
         transitively pull Entra in — consumers opt into Microsoft.Graph /
         Azure.Identity weight only when they actually want the adapter. -->
    <ProjectReference Include="..\..\src\VisuAuth.Entra\VisuAuth.Entra.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.Identity.EntityFrameworkCore" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Sqlite" />
    <!-- Required for `dotnet ef migrations add` / `database update`.
         PrivateAssets=All keeps it as a dev-time-only reference so
         the design package doesn't leak into anything that consumes
         the sample (we don't pack it, but defence in depth). -->
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design">
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
    <!-- Sample-only: powers each external-login button when the developer
         fills in ClientId/ClientSecret in ExternalProviders.*. The VisuAuth
         packages themselves ship no provider deps — consumers add the ones
         they actually wire. -->
    <PackageReference Include="Microsoft.AspNetCore.Authentication.MicrosoftAccount" />
    <PackageReference Include="Microsoft.AspNetCore.Authentication.Google" />
    <PackageReference Include="AspNet.Security.OAuth.Apple" />
    <PackageReference Include="AspNet.Security.OAuth.GitHub" />
  </ItemGroup>

</Project>
