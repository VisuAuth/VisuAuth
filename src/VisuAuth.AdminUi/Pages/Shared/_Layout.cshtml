@using VisuAuth.Abstractions.Tenancy
@inject ITenantContext TenantContext
@{
    var title = ViewData["Title"] as string ?? "VisuAuth Admin";
}<!doctype html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>@title</title>
    @* asp-append-version pins ?v={file-hash}, so a stylesheet rebuild forces
       browsers to fetch the new content instead of serving a stale cached copy. *@
    <link rel="stylesheet" href="/_content/VisuAuth.AdminUi/visuauth.css" asp-append-version="true" />
    @*
       TODO: Embed htmx as a static asset under wwwroot/ in a future PR for
       offline/airgapped support. Using the CDN keeps this PR small.
    *@
    <script src="https://unpkg.com/htmx.org@2.0.4"
            integrity="sha384-HGfztofotfshcF7+8n44JQL2oJmowVChPTg48S+jvZoztPfvwD79OC/LTtG6dMp+"
            crossorigin="anonymous"
            defer></script>
    <script src="/_content/VisuAuth.AdminUi/visuauth.js" asp-append-version="true" defer></script>
</head>
<body>
    <div class="va-shell">
        @{
            // Highlight the sidebar entry that matches the current URL. Razor
            // partials inherit the host request, so Request.Path is the live URL.
            var path = Context.Request.Path.Value ?? string.Empty;
            string NavClass(string segment) =>
                path.StartsWith(segment, StringComparison.OrdinalIgnoreCase) ? "va-active" : "";
        }
        <aside class="va-sidebar">
            <a class="va-brand" href="/visuauth/admin/users">VisuAuth</a>
            @if (TenantContext.IsMultiTenancyEnabled)
            {
                <div class="va-tenant-indicator" title="Active tenant scope">
                    <span class="va-field-label">Tenant</span>
                    @if (TenantContext.CurrentTenantId is { Length: > 0 } tenantId)
                    {
                        <code class="va-tenant-id">@tenantId</code>
                    }
                    else
                    {
                        <span class="va-muted">(global)</span>
                    }
                </div>
            }
            <nav class="va-nav">
                <a href="/visuauth/admin/users" class="@NavClass("/visuauth/admin/users")">Users</a>
                <a href="/visuauth/admin/roles" class="@NavClass("/visuauth/admin/roles")">Roles</a>
                <a href="#" aria-disabled="true" class="va-muted">Tenants (soon)</a>
            </nav>
        </aside>
        <main class="va-main">
            @RenderBody()
        </main>
    </div>
</body>
</html>
