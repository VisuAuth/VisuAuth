@model VisuAuth.AdminUi.Pages.Admin.Users.DetailModel
@{
    var detail = Model.Detail;
    var capabilities = Model.Capabilities;
}

<div class="va-page-header">
    <div>
        <a class="va-back" href="/visuauth/admin/users">@Ls["Users.Detail.Back"]</a>
        <h1>@detail.Email</h1>
        <div class="va-muted va-detail-subtitle">
            @(detail.UserName ?? Ls["Common.Dash"].Value)
            <span class="va-detail-id">@detail.Id</span>
        </div>
    </div>
    <div class="va-detail-status">
        @if (detail.IsEnabled)
        {
            <span class="va-badge va-success">@Ls["Common.StatusActive"]</span>
        }
        else
        {
            <span class="va-badge va-danger">@Ls["Common.StatusLocked"]</span>
        }
        @if (detail.EmailConfirmed)
        {
            <span class="va-badge va-success">@Ls["Users.Detail.BadgeEmailVerified"]</span>
        }
        else
        {
            <span class="va-badge">@Ls["Users.Detail.BadgeEmailPending"]</span>
        }
        @if (detail.TwoFactorEnabled)
        {
            <span class="va-badge va-success">@Ls["Users.Detail.Badge2faOn"]</span>
        }
        else
        {
            <span class="va-badge">@Ls["Users.Detail.Badge2faOff"]</span>
        }
    </div>
</div>

@if (Model.ActionErrors.Count > 0)
{
    <div class="va-alert va-alert-danger" role="alert">
        <strong>@Ls["Users.Detail.ActionFailed"]</strong>
        <ul>
            @foreach (var err in Model.ActionErrors)
            {
                <li>@err</li>
            }
        </ul>
    </div>
}
else if (Model.ActionMessage is { Length: > 0 } message)
{
    <div class="va-alert va-alert-success" role="status">@message</div>
}

@if (Model.LastTemporaryPassword is { Length: > 0 } temp)
{
    <div class="va-alert va-alert-info" role="status">
        <p>
            <strong>@Ls["Users.Detail.TempPasswordHeading"]</strong> @Ls["Users.Detail.TempPasswordDesc"]
        </p>
        <partial name="_CopyableSecret" model="@temp" />
    </div>
}

<partial name="_ProfileSection" model="Model" />
<partial name="_SecuritySection" model="Model" />

@if (capabilities.SupportsRoleManagement)
{
    <partial name="_RolesSection" model="Model" />
}

@if (capabilities.SupportsCustomClaims)
{
    <section class="va-card va-detail-card">
        <h2>@Ls["Users.Claims.Heading"] <span class="va-muted va-count">(@detail.Claims.Count)</span></h2>
        @if (detail.Claims.Count == 0)
        {
            <p class="va-empty-inline">@Ls["Users.Claims.None"]</p>
        }
        else
        {
            <table class="va-table">
                <thead>
                <tr>
                    <th>@Ls["Users.Claims.Col.Type"]</th>
                    <th>@Ls["Users.Claims.Col.Value"]</th>
                    <th>@Ls["Users.Claims.Col.Issuer"]</th>
                </tr>
                </thead>
                <tbody>
                @foreach (var claim in detail.Claims)
                {
                    <tr>
                        <td><code>@claim.Type</code></td>
                        <td>@claim.Value</td>
                        <td class="va-muted">@(claim.Issuer ?? Ls["Common.Dash"].Value)</td>
                    </tr>
                }
                </tbody>
            </table>
        }
    </section>
}

@if (capabilities.SupportsExternalProviders)
{
    <section class="va-card va-detail-card">
        <h2>@Ls["Users.External.Heading"] <span class="va-muted va-count">(@detail.ExternalLogins.Count)</span></h2>
        @if (detail.ExternalLogins.Count == 0)
        {
            <p class="va-empty-inline">@Ls["Users.External.None"]</p>
        }
        else
        {
            <table class="va-table">
                <thead>
                <tr>
                    <th>@Ls["Users.External.Col.Provider"]</th>
                    <th>@Ls["Users.External.Col.ProviderKey"]</th>
                </tr>
                </thead>
                <tbody>
                @foreach (var login in detail.ExternalLogins)
                {
                    <tr>
                        <td>@(login.DisplayName ?? login.Provider)</td>
                        <td><code>@login.ProviderKey</code></td>
                    </tr>
                }
                </tbody>
            </table>
        }
    </section>
}

<section class="va-card va-detail-card va-danger-zone">
    <div class="va-detail-card-header">
        <h2>@Ls["Users.Danger.Heading"]</h2>
    </div>
    <p class="va-muted">@Ls["Users.Danger.Desc"]</p>
    <div class="va-actions">
        @* asp-page-handler="Delete" lets the form tag helper generate the
           action URL with the current id route value and ensures the
           antiforgery token is injected. The explicit @Html.AntiForgeryToken()
           is belt-and-suspenders for environments where the tag helper does
           not auto-engage (rare, but cheap insurance). *@
        <form method="post" asp-page-handler="Delete">
            @Html.AntiForgeryToken()
            <button type="submit"
                    class="va-btn va-btn-danger"
                    onclick="return confirm('@Ls["Users.Danger.DeleteConfirm"]');">
                @Ls["Users.Danger.Delete"]
            </button>
        </form>
    </div>
</section>
