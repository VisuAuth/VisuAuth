@using VisuAuth.Abstractions.Tenancy
@inject ITenantContext TenantContext
@model VisuAuth.AdminUi.Pages.Admin.Users.IndexModel
@{
    var result = Model.Result;
    var hasResults = result.Items.Count > 0;
    var showTenantColumn = TenantContext.IsMultiTenancyEnabled;

    // Build a query-string carrying every active filter so pagination
    // preserves the user's narrowing instead of resetting to the unfiltered
    // first page on every Next / Previous click.
    string PageLink(int page)
    {
        var qs = new List<string> { $"page={page}" };
        if (!string.IsNullOrEmpty(Model.SearchTerm)) qs.Add($"q={Uri.EscapeDataString(Model.SearchTerm)}");
        if (!string.IsNullOrEmpty(Model.RoleFilter)) qs.Add($"role={Uri.EscapeDataString(Model.RoleFilter)}");
        if (!string.IsNullOrEmpty(Model.StatusFilter)) qs.Add($"status={Uri.EscapeDataString(Model.StatusFilter)}");
        if (!string.IsNullOrEmpty(Model.VerifiedFilter)) qs.Add($"verified={Uri.EscapeDataString(Model.VerifiedFilter)}");
        if (!string.IsNullOrEmpty(Model.TwoFactorFilter)) qs.Add($"twofa={Uri.EscapeDataString(Model.TwoFactorFilter)}");
        return $"/visuauth/admin/users?{string.Join("&", qs)}";
    }
}
<div id="va-users-table" class="va-card">
    @if (hasResults)
    {
        <table class="va-table">
            <thead>
            <tr>
                <th>Email</th>
                <th>Username</th>
                @if (showTenantColumn)
                {
                    <th>Tenant</th>
                }
                <th>Status</th>
                <th>2FA</th>
                <th>Verified</th>
            </tr>
            </thead>
            <tbody>
            @foreach (var user in result.Items)
            {
                <tr>
                    <td>
                        <a class="va-row-link" href="/visuauth/admin/users/@user.Id">@user.Email</a>
                    </td>
                    <td>@(user.UserName ?? "—")</td>
                    @if (showTenantColumn)
                    {
                        <td>
                            @if (!string.IsNullOrEmpty(user.TenantId))
                            {
                                <code class="va-tenant-id">@user.TenantId</code>
                            }
                            else
                            {
                                <span class="va-muted">—</span>
                            }
                        </td>
                    }
                    <td>
                        @if (user.IsEnabled)
                        {
                            <span class="va-badge va-success">Active</span>
                        }
                        else
                        {
                            <span class="va-badge va-danger">Locked</span>
                        }
                    </td>
                    <td>
                        <span class="va-badge">@(user.TwoFactorEnabled ? "On" : "Off")</span>
                    </td>
                    <td>
                        <span class="va-badge @(user.EmailConfirmed ? "va-success" : "")">
                            @(user.EmailConfirmed ? "Yes" : "Pending")
                        </span>
                    </td>
                </tr>
            }
            </tbody>
        </table>

        <div class="va-pagination">
            <div>
                Showing @(((result.Page - 1) * result.PageSize) + 1)–@Math.Min(result.Page * result.PageSize, result.Total)
                of @result.Total
            </div>
            <div>
                @if (result.HasPrevious)
                {
                    <a href="@PageLink(result.Page - 1)"
                       hx-get="@PageLink(result.Page - 1)"
                       hx-target="#va-users-table"
                       hx-swap="outerHTML"
                       hx-push-url="true">‹ Previous</a>
                }
                else
                {
                    <span class="va-disabled">‹ Previous</span>
                }
                <span class="va-muted">Page @result.Page of @Math.Max(result.TotalPages, 1)</span>
                @if (result.HasNext)
                {
                    <a href="@PageLink(result.Page + 1)"
                       hx-get="@PageLink(result.Page + 1)"
                       hx-target="#va-users-table"
                       hx-swap="outerHTML"
                       hx-push-url="true">Next ›</a>
                }
                else
                {
                    <span class="va-disabled">Next ›</span>
                }
            </div>
        </div>
    }
    else
    {
        <div class="va-empty">
            @if (!string.IsNullOrWhiteSpace(Model.SearchTerm))
            {
                <p>No users match <strong>@Model.SearchTerm</strong>.</p>
            }
            else
            {
                <p>No users yet.</p>
            }
        </div>
    }
</div>
