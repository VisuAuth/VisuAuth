@*
    Theming layer 3 demo (CLAUDE.md §8.4) — layout override.

    Razor's view-engine search list is consulted whenever a layout is
    resolved. Because /Views/VisuAuth/Shared/{name}.cshtml sits at the
    top of the list (added by VisuAuthViewLocationExpander), this file
    wins over the package's _EndUserLayout for every end-user page
    (login, register, password reset, ...).

    Structure-preserving copy of the package default — same stylesheet +
    script references (including the theme initializer), same brand mark,
    language switcher and light/dark toggle — plus a small banner so the
    override is visibly active.
*@
@{
    var title = ViewData["Title"] as string ?? "VisuAuth";
    var brand = ViewData["Brand"] as string ?? "VisuAuth";
    var pageLang = System.Globalization.CultureInfo.CurrentUICulture.Name;
}<!doctype html>
<html lang="@pageLang">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>@title</title>
    <link rel="stylesheet" href="/_content/VisuAuth.AdminUi/visuauth.css" asp-append-version="true" />
    <link rel="stylesheet" href="/_content/VisuAuth.EndUserUi/visuauth-enduser.css" asp-append-version="true" />
    <va-theme-style />
    <script src="/_content/VisuAuth.AdminUi/htmx.min.js" asp-append-version="true" defer></script>
    <script src="/_content/VisuAuth.AdminUi/visuauth.js" asp-append-version="true" defer></script>
    @* Theme initializer — synchronous (NOT deferred) so the stored light/dark
       choice applies before the card paints (no flash). Mirrors the package. *@
    <script src="/_content/VisuAuth.AdminUi/va-theme-init.js" asp-append-version="true"></script>
</head>
<body class="va-enduser-body" data-va-override="sample">
    <main class="va-enduser-shell">
        <div class="va-enduser-card">
            <a class="va-brand va-enduser-brand" href="/">
                <span class="va-brand-mark" aria-hidden="true">
                    <svg viewBox="0 0 40 40" width="20" height="20" fill="none" aria-hidden="true">
                        <path d="M11 12.5 L20 27.5 L29 12.5" stroke="currentColor" stroke-width="3.4" stroke-linecap="round" stroke-linejoin="round" />
                        <circle cx="20" cy="14.2" r="2.4" fill="currentColor" />
                    </svg>
                </span>
                <span>@brand</span>
            </a>
            <p class="va-override-banner" style="margin:0 0 0.75rem;font-size:0.75rem;color:var(--visuauth-muted);text-align:center;">
                Sample app override — <code>_EndUserLayout.cshtml</code>
            </p>
            @RenderBody()
            <va-language-switcher class="va-enduser-lang" />
            <button type="button" class="va-theme-toggle va-enduser-theme-toggle" data-va-theme-toggle aria-label="@Ls["Sidebar.ThemeToggle"]">
                <svg class="va-theme-toggle-icon va-icon-moon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79z"/></svg>
                <svg class="va-theme-toggle-icon va-icon-sun" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="12" cy="12" r="4"/><path d="M12 2v2M12 20v2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M2 12h2M20 12h2M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4"/></svg>
                <span>@Ls["Sidebar.ThemeLabel"]</span>
            </button>
        </div>
    </main>
</body>
</html>
